"},{"text":" and a placeholder body.","type":"text"}],"type":"paragraph"}],"type":"step","media":null,"code":"DiceView-01.swift","runtimePreview":"DiceView-01.png","caption":[]},{"content":[{"inlineContent":[{"text":"Add ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" properties for the current roll and loading state. In ","type":"text"},{"code":".task","type":"codeVoice"},{"text":", iterate ","type":"text"},{"code":"roller.lastRoll.valueWithState","type":"codeVoice"},{"text":" and update state from each snapshot. Show the roll as a large number — ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" renders as ","type":"text"},{"code":"\"—\"","type":"codeVoice"},{"text":" before the first roll — and a ","type":"text"},{"code":"ProgressView","type":"codeVoice"},{"text":" while the source is refreshing.","type":"text"}],"type":"paragraph"}],"type":"step","media":null,"code":"DiceView-02.swift","runtimePreview":"DiceView-02.png","caption":[]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a Roll button that calls "},{"type":"codeVoice","code":"refresh(clear: true)"},{"text":". Passing ","type":"text"},{"code":"clear: true","type":"codeVoice"},{"text":" sets ","type":"text"},{"code":"lastRoll","type":"codeVoice"},{"text":" back to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" immediately, so the display returns to ","type":"text"},{"code":"\"—\"","type":"codeVoice"},{"text":" while the next number is being generated — a clear visual cue that a new roll is in flight.","type":"text"}]}],"type":"step","media":null,"code":"DiceView-03.swift","runtimePreview":"DiceView-03.png","caption":[]}],"title":"Building the Dice View","contentSection":[{"mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"Subscribe to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/valueWithState","type":"reference"},{"text":" in a SwiftUI view. This stream delivers a snapshot on every change — value or loading state — so one subscription drives both the roll display and the ","type":"text"},{"type":"codeVoice","code":"ProgressView"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":".task"},{"type":"text","text":" modifier iterates the stream for as long as the view is on screen. When the view disappears, the task is cancelled automatically — a behaviour that becomes relevant when auto-roll is introduced in the next section."}],"type":"paragraph"}],"kind":"contentAndMedia"}],"anchor":"Building-the-Dice-View"},{"title":"Rolling Automatically","contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Chain ","type":"text"},{"code":".autoRefresh(.seconds(2))","type":"codeVoice"},{"text":" to roll the die automatically every two seconds while the view is visible. The timer is subscriber-driven: it starts when the first subscriber appears on ","type":"text"},{"code":"lastRoll.values","type":"codeVoice"},{"text":" and stops when the last one disappears.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"DiceView"},{"text":" cancels when the view leaves the screen, the auto-roll timer stops automatically — no manual cleanup is required.","type":"text"}]}],"mediaPosition":"trailing"}],"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Chain "},{"type":"codeVoice","code":".autoRefresh(.seconds(2))"},{"type":"text","text":" before "},{"type":"codeVoice","code":".build()"},{"type":"text","text":". The view requires no changes: the existing "},{"type":"codeVoice","code":"valueWithState"},{"type":"text","text":" subscription picks up each automatic roll as it arrives."}]}],"type":"step","code":"DiceRoller-03.swift","caption":[],"media":null,"runtimePreview":null}],"anchor":"Rolling-Automatically"}]},{"assessments":[{"title":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"lastRoll"},{"type":"text","text":" is typed as "},{"type":"codeVoice","code":"DataSource<Int?>"},{"type":"text","text":". What does "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" represent?"}]}],"type":"multiple-choice","content":[],"choices":[{"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Errors are handled separately by the "},{"code":"onError","type":"codeVoice"},{"type":"text","text":" closure, not encoded as "},{"type":"codeVoice","code":"nil"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" value comes from Silo’s built-in empty state for ","type":"text"},{"type":"codeVoice","code":"Optional"},{"text":" types — it simply means the source has never been fetched.","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An error occurred during the last roll."}]}],"isCorrect":false},{"justification":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Optional"},{"type":"text","text":" is one of Silo’s built-in empty types. The source starts as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and stays "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" until "},{"type":"codeVoice","code":"refresh()"},{"type":"text","text":" is first called — or after "},{"type":"codeVoice","code":"refresh(clear: true)"},{"type":"text","text":" resets it while a new roll is in flight."}]}],"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The die has not been rolled yet, or the value was cleared."}]}]},{"justification":[{"type":"paragraph","inlineContent":[{"text":"Auto-roll is configured via ","type":"text"},{"type":"codeVoice","code":".autoRefresh()"},{"text":" on the builder, not encoded in the value type. ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" means the source has no value yet, regardless of whether auto-roll is on or off.","type":"text"}]}],"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Auto-roll is disabled."}]}]}]},{"content":[],"choices":[{"content":[{"inlineContent":[{"type":"text","text":"Two rolls — one for each call."}],"type":"paragraph"}],"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"Concurrent "},{"type":"codeVoice","code":"refresh()"},{"type":"text","text":" calls are deduplicated. The second caller joins the in-flight task started by the first and awaits its result — only one roll ever happens."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"One roll — the second call joins the in-flight task.","type":"text"}],"type":"paragraph"}],"isCorrect":true,"justification":[{"inlineContent":[{"text":"Silo deduplicates concurrent refreshes. The second ","type":"text"},{"code":"refresh()","type":"codeVoice"},{"text":" call detects an active task and awaits it instead of starting a new one. Both callers receive the same result.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Zero rolls — the second call cancels the first."}]}],"isCorrect":false,"justification":[{"type":"paragraph","inlineContent":[{"text":"Calls are deduplicated, not cancelled. The in-flight task runs to completion and both callers receive the result.","type":"text"}]}]}],"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You call "},{"code":"refresh(clear: true)","type":"codeVoice"},{"type":"text","text":" and then "},{"code":"refresh(clear: true)","type":"codeVoice"},{"type":"text","text":" again immediately. How many rolls happen?"}]}],"type":"multiple-choice"},{"content":[],"choices":[{"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The timer stops automatically because there are no more subscribers."}]}],"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Auto-refresh is subscriber-driven. The "},{"code":".task","type":"codeVoice"},{"type":"text","text":" modifier in "},{"code":"DiceView","type":"codeVoice"},{"type":"text","text":" cancels when the view disappears, removing the last subscriber from "},{"code":"lastRoll.values","type":"codeVoice"},{"type":"text","text":". With no subscribers, the timer stops — no manual cleanup is needed."}]}]},{"isCorrect":false,"content":[{"inlineContent":[{"type":"text","text":"The timer keeps running in the background indefinitely."}],"type":"paragraph"}],"justification":[{"inlineContent":[{"text":"The timer is subscriber-driven, not a free-running background process. It only runs while at least one subscriber is active on the ","type":"text"},{"type":"codeVoice","code":"values"},{"text":" stream.","type":"text"}],"type":"paragraph"}]},{"isCorrect":false,"content":[{"inlineContent":[{"text":"The timer stops, but only if you call ","type":"text"},{"type":"codeVoice","code":"invalidate()"},{"text":" on the ","type":"text"},{"type":"codeVoice","code":"DiceRoller"},{"text":".","type":"text"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"text":"No manual invalidation is needed. Silo tracks the subscriber count automatically and stops the timer when it reaches zero.","type":"text"}],"type":"paragraph"}]}],"title":[{"type":"paragraph","inlineContent":[{"text":"You configure ","type":"text"},{"code":".autoRefresh(.seconds(2))","type":"codeVoice"},{"type":"text","text":". The user navigates away and "},{"type":"codeVoice","code":"DiceView"},{"type":"text","text":" disappears. What happens to the timer?"}]}],"type":"multiple-choice"}],"kind":"assessments","anchor":"Check-Your-Understanding"},{"kind":"callToAction","abstract":[{"type":"text","text":"Build a configurable dice roller that automatically re-rolls whenever the player changes the dice type or count. You will learn how to declare dependencies, choose the right refresh policy, and wir