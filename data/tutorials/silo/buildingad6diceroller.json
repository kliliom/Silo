diceroller","kind":"project","role":"project","estimatedTime":"15min"},"DiceRoller-02.swift":{"type":"file","identifier":"DiceRoller-02.swift","content":["import Silo","","@MainActor","class DiceRoller {","    static let shared = DiceRoller()","","    let lastRoll: DataSource<Int?>","","    private init() {","        lastRoll = dataSource {","            try? await Task.sleep(for: .seconds(1))","            return Int.random(in: 1...6)","        } onError: { _ in","            .keep","        }","        .build()","    }","}"],"fileName":"DiceRoller.swift","syntax":"swift","fileType":"swift","highlights":[{"line":7},{"line":8},{"line":9},{"line":10},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17}]},"doc://Silo/documentation/Silo/DataSource":{"navigatorTitle":[{"kind":"identifier","text":"DataSource"}],"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DataSource"}],"abstract":[{"text":"Manages asynchronous data fetching, caching, and reactive streaming for a single value type.","type":"text"}],"role":"symbol","title":"DataSource","url":"\/documentation\/silo\/datasource","kind":"symbol","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource"},"doc://Silo/tutorials/Silo/ReactiveDependencies#Building-the-Roll-View":{"abstract":[{"text":"Build a configurable dice roller that automatically re-rolls whenever the player changes the dice type or count. You will learn how to declare dependencies, choose the right refresh policy, and wire SwiftUI pickers to reactive streams — resulting in a fully functional application.","type":"text"}],"type":"section","identifier":"doc:\/\/Silo\/tutorials\/Silo\/ReactiveDependencies#Building-the-Roll-View","title":"Building the Roll View","url":"\/tutorials\/silo\/reactivedependencies#Building-the-Roll-View","kind":"section","role":"pseudoSymbol"},"DiceView-03.swift":{"type":"file","identifier":"DiceView-03.swift","content":["import Silo","import SwiftUI","","struct DiceView: View {","    let roller = DiceRoller.shared","","    @State private var roll: Int? = nil","    @State private var isRolling = false","","    var body: some View {","        VStack(spacing: 24) {","            Text(roll.map(String.init) ?? \"—\")","                .font(.system(size: 80, weight: .bold, design: .rounded))","                .overlay {","                    if isRolling {","                        ProgressView()","                            .controlSize(.extraLarge)","                            .padding(24)","                            .background(.regularMaterial, in: .circle)","                    }","                }","","            Button(\"Roll\") {","                Task { try? await roller.lastRoll.refresh(clear: true) }","            }","            .buttonStyle(.borderedProminent)","        }","        .task {","            for await snapshot in roller.lastRoll.valueWithState {","                roll = snapshot.value","                isRolling = snapshot.state.isRefreshing","            }","        }","    }","}"],"fileName":"DiceView.swift","syntax":"swift","fileType":"swift","highlights":[{"line":22},{"line":23},{"line":24},{"line":25},{"line":26}]},"doc://Silo/documentation/Silo/DataSourceValueWithState":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DataSourceValueWithState"}],"title":"DataSourceValueWithState","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DataSourceValueWithState"}],"role":"symbol","url":"\/documentation\/silo\/datasourcevaluewithstate","abstract":[{"text":"A paired snapshot of a ","type":"text"},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource","isActive":true,"type":"reference"},{"text":"’s cached value and loading state at one point in time.","type":"text"}],"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSourceValueWithState","type":"topic"},"doc://Silo/tutorials/Silo/ReactiveDep