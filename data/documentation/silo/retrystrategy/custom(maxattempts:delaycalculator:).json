{"abstract":[{"text":"Creates a custom retry strategy with a user-defined delay calculator.","type":"text"}],"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Silo\/documentation\/Silo\/RetryStrategy\/custom(maxAttempts:delayCalculator:)"},"hierarchy":{"paths":[["doc:\/\/Silo\/documentation\/Silo","doc:\/\/Silo\/documentation\/Silo\/RetryStrategy"]]},"variants":[{"paths":["\/documentation\/silo\/retrystrategy\/custom(maxattempts:delaycalculator:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"custom"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxAttempts"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"delayCalculator"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Silo\/documentation\/Silo\/RetryStrategy","preciseIdentifier":"s:4Silo13RetryStrategyV","text":"RetryStrategy"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum number of fetch attempts, including the first try."},{"type":"text","text":" "},{"type":"text","text":"For example, "},{"type":"codeVoice","code":"maxAttempts: 3"},{"type":"text","text":" means one initial attempt plus up to two retries."}]}],"name":"maxAttempts"},{"content":[{"inlineContent":[{"type":"text","text":"Called after attempt "},{"type":"codeVoice","code":"n"},{"type":"text","text":" fails ("},{"type":"codeVoice","code":"n"},{"text":" ranges from 1 to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"maxAttempts - 1"},{"text":", where 1 is the initial attempt); returns the delay to wait","type":"text"},{"text":" ","type":"text"},{"text":"before attempt ","type":"text"},{"type":"codeVoice","code":"n + 1"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"delayCalculator"}]},{"content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"text":"A retry strategy with custom delay calculation","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Allows complete control over retry timing with a custom calculation function."}]},{"type":"paragraph","inlineContent":[{"text":"Example:","type":"text"}]},{"code":["\/\/ Fibonacci backoff — 6 attempts, delays between them: 1s, 1s, 2s, 3s, 5s","var prev = 0, curr = 1","let strategy = .custom(maxAttempts: 6) { attempt in","    let delay = curr","    (prev, curr) = (curr, prev + curr)","    return .seconds(delay)","}","","\/\/ Jittered exponential backoff",".custom(maxAttempts: 5) { attempt in","    let base = pow(2.0, Double(attempt - 1))","    let jitter = Double.random(in: 0.8...1.2)","    return .seconds(base * jitter)","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"metadata":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"custom","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maxAttempts","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"delayC