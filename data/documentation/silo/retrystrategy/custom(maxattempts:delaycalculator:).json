backoff — 6 attempts, delays between them: 1s, 1s, 2s, 3s, 5s","var prev = 0, curr = 1","let strategy = .custom(maxAttempts: 6) { attempt in","    let delay = curr","    (prev, curr) = (curr, prev + curr)","    return .seconds(delay)","}","","\/\/ Jittered exponential backoff",".custom(maxAttempts: 5) { attempt in","    let base = pow(2.0, Double(attempt - 1))","    let jitter = Double.random(in: 0.8...1.2)","    return .seconds(base * jitter)","}"]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Silo\/documentation\/Silo\/RetryStrategy\/custom(maxAttempts:delayCalculator:)"},"sections":[],"references":{"doc://Silo/documentation/Silo/RetryStrategy/custom(maxAttempts:delayCalculator:)":{"url":"\/documentation\/silo\/retrystrategy\/custom(maxattempts:delaycalculator:)","identifier":"doc:\/\/Silo\/documentation\/Silo\/RetryStrategy\/custom(maxAttempts:delayCalculator:)","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"custom"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxAttempts"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"delayCalculator"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"RetryStrategy","preciseIdentifier":"s:4Silo13RetryStrategyV"}],"abstract":[{"text":"Creates a custom retry strategy with a user-defined delay calculator.","type":"text"}],"title":"custom(maxAttempts:delayCalculator:)"},"doc://Silo/documentation/Silo":{"type":"topic","abstract":[{"text":"Reactive async data management for Swift 6 — fetch, cache, and stream data with zero