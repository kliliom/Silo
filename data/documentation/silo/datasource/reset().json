text":"subscribers restart auto-refresh as usual. Has no effect after "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/terminate()"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Detach every screen observing the source, e.g. when switching accounts","userSource.reset()"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/silo\/datasource\/reset()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Cancels all in-flight work and finishes all active streams, leaving the source usable."}],"kind":"symbol","references":{"doc://Silo/documentation/Silo":{"abstract":[{"type":"text","text":"Reactive async data management for Swift 6 — fetch, cache, and stream data with zero dependencies."}],"kind":"symbol","role":"collection","type":"topic","title":"Silo","url":"\/documentation\/silo","identifier":"doc:\/\/Silo\/documentation\/Silo"},"doc://Silo/documentation/Silo/DataSource":{"title":"DataSource","url":"\/documentation\/silo\/datasource","abstract":[{"type":"text","text":"Manages asynchronous data fetching, caching, and reactive streaming for a single value type."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DataSource"}],"type":"topic","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DataSource"}]},"doc://Silo/documentation/Silo/DataSource/terminate()":{"abstract":[{"type":"text","text":"Permanently shuts the data source down."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"terminate","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic","title":"terminate()","url":"\/documentation\/silo\/datasource\/terminate()","identifier":"doc:\/\/Silo\/documentation\/S