ependencies and Reactive Fetching","abstract":[{"text":"Automatically re-fetch data whenever upstream async stream values change.","type":"text"}],"type":"topic","kind":"article","url":"\/documentation\/silo\/dependencies"},"doc://Silo/documentation/Silo":{"abstract":[{"type":"text","text":"Reactive async data management for Swift 6 — fetch, cache, and stream data with zero dependencies."}],"kind":"symbol","role":"collection","type":"topic","title":"Silo","url":"\/documentation\/silo","identifier":"doc:\/\/Silo\/documentation\/Silo"},"doc://Silo/documentation/Silo/DataSource":{"title":"DataSource","url":"\/documentation\/silo\/datasource","abstract":[{"type":"text","text":"Manages asynchronous data fetching, caching, and reactive streaming for a single value type."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DataSource"}],"type":"topic","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DataSource"}]}}}