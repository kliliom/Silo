{"abstract":[{"type":"text","text":"Gate fetches on runtime conditions such as network availability or user authentication state."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"prerequisite"}]},{"text":" is an async check that must pass before a fetch is allowed to proceed. If any prerequisite returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", the fetch is cancelled with a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Silo\/documentation\/Silo\/PrerequisiteError","isActive":true},{"type":"text","text":" instead of hitting the network."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Prerequisites are the right tool when a fetch shouldn’t even be attempted under certain conditions — not when you want to change the "},{"type":"emphasis","inlineContent":[{"text":"result","type":"text"}]},{"type":"text","text":" of a failed fetch (use "},{"type":"codeVoice","code":"onError"},{"type":"text","text":" for that)."}],"type":"paragraph"},{"rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"text":"Prerequisites","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"onError","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Prevent fetches that would certainly fail"}],"type":"paragraph"}],[{"inlineContent":[{"text":"React to fetches that did fail","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"When evaluated","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Before every fetch attempt","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"After a fetch throws"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"If check fails"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Throws ","type":"text"},{"type":"codeVoice","code":"PrerequisiteError"},{"text":"; no network call","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Decides cache state; re-throws the error"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Common uses"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Network offline, not logged in"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Transient errors, auth expiry, rate limits"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"anchor":"Defining-a-Prerequisite","type":"heading","text":"Defining a Prerequisite","level":2},{"inlineContent":[{"type":"text","text":"Conform any "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" type to "},{"type":"reference","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSourceRefreshPrerequisite","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["struct NetworkAvailable: DataSourceRefreshPrerequisite {","    func check() async -> Bool {","        await NetworkMonitor.shared.isConnected","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"check()"},{"type":"text","text":" method is "},{"type":"codeVoice","code":"async"},{"type":"text","text":", so you can perform any awaitable check — including one that itself involves a network or system call."}],"type":"paragraph"},{"anchor":"Adding-Prerequisites-to-a-Data-Source","type":"heading","text":"Adding Prerequisites to a Data Source","level":2},{"inlineContent":[{"type":"text","text":"Chain "},{"type":"codeVoice","code":".requires(_:)"},{"type":"text","text":" on the builder before "},{"type":"codeVoice","code":".build()"},{"type":"text","text":". Multiple prerequisites are evaluated in order; the first failure stops the check and throws:"}],"type":"paragraph"},{"code":["let profileSource = dataSource {","    try await api.fetchProfile()","} onError: { _ in .keep }",".requires(NetworkAvailable())",".requires(UserAuthenticated())",".build()"],"syntax":"swift","type":"codeListing"},{"text":"Handling Prerequisite Failures","type":"heading","anchor":"Handling-Prerequisite-Failures","level":2},{"inlineContent":[{"type":"text","text":"When a prerequisite fails, "},{"type":"codeVoice","code":"refresh()"},{"type":"text","text":" throws a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Silo\/documentation\/Silo\/PrerequisiteError"},{"type":"text","text":". Catch it to distinguish prerequisite failures from network failures:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    try await profileSource.refresh()","} catch let error as PrerequisiteError {","    \/\/ Condition not met — show an appropriate message","    showOfflineBanner(error.message)","} catch {","    \/\/ Actual fetch error","    showErrorAlert(error)","}"]},{"level":2,"anchor":"Common-Prerequisite-Implementations","type":"heading","text":"Common Prerequisite Implementations"},{"level":3,"anchor":"Network-Reachability","type":"heading","text":"Network Reachability"},{"syntax":"swift","type":"codeListing","code":["import Network","","actor NetworkMonitor {","    static let shared = NetworkMonitor()","","    private let monitor = NWPathMonitor()","    private var isConnected = false","","    init() {","        monitor.pathUpdateHandler = { [weak self] path in","            Task { await self?.update(path.status == .satisfied) }","        }","        monitor.start(queue: .global(qos: .background))","    }","","    private func update(_ connected: Bool) { isConnected = connected }","    func checkConnected() async -> Bool { isConnected }","}","","struct NetworkAvailable: DataSourceRefreshPrerequisite {","    func check() async -> Bool {","        await NetworkMonitor.shared.checkConnected()","    }","}"]},{"level":3,"anchor":"User-Authentication","type":"heading","text":"User Authentication"},{"syntax":"swift","type":"codeListing","code":["struct UserAuthenticated: DataSourceRefreshPrerequisite {","    func check() async -> Bool {","        await AuthStore.shared.isLoggedIn","    }","}"]},{"level":3,"anchor":"Feature-Flag","type":"heading","text":"Feature Flag"},{"syntax":"swift","type":"codeListing","code":["struct FeatureEnabled: DataSourceRefreshPrerequisite {","    let flagName: String","","    func check() async -> Bool {","        await FeatureFlags.shared.isEnabled(flagName)","    }","}","","\/\/ Usage:","dataSource { ... }","    .requires(FeatureEnabled(flagName: \"newFeedAlgorithm\"))","    .build()"]},{"level":3,"anchor":"Combined-Example","type":"heading","text":"Combined Example"},{"syntax":"swift","type":"codeListing","code":["let secureDataSource = dataSource {","    try await api.fetchSecureData()","} onError: { error in","    error is AuthError ? .clear : .keep","}",".requires(NetworkAvailable())",".requires(UserAuthenticated())",".requires(FeatureEnabled(flagName: \"secureFeature\"))",".retry(maxAttempts: 2, delay: .seconds(1)) { error in","    error is URLError ? .retry : .stop","}",".ttl(.seconds(300))",".build()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this configuration:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Network is checked first — no request attempted if offline"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Auth is verified second — no request if logged out","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature flag is checked third — no request if feature is off"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If all pass and the fetch fails, retry once more (2 attempts in total)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cache results for 5 minutes"}]}]}]},{"text":"Prerequisite Evaluation Order","anchor":"Prerequisite-Evaluation-Order","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prerequisites are evaluated sequentially in the order they were added. Evaluation stops at the first failure — subsequent prerequisites are not checked."}]},{"type":"codeListing","code":[".requires(NetworkAvailable())   \/\/ Checked first",".requires(UserAuthenticated())  \/\/ Only checked if network is available",".requires(FeatureEnabled(...))  \/\/ Only checked if both above pass"],"syntax":"swift"},{"text":"Prerequisites and Retry","anchor":"Prerequisites-and-Retry","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Prerequisite checks happen "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the retry loop. If a prerequisite fails, the fetch is not attempted — and the retry strategy never kicks in. This is intentional: retrying a fetch when the prerequisite is already known to be unmet would be wasteful."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need to retry until a prerequisite passes (for example, waiting for a network connection to be restored), handle that at a higher level — poll or observe the prerequisite’s underlying state and call "},{"type":"codeVoice","code":"refresh()"},{"type":"text","text":" when it changes."}]}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Silo\/documentation\/Silo"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/silo\/prerequisites"]}],"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Silo\/documentation\/Silo\/ErrorHandling","doc:\/\/Silo\/documentation\/Silo\/DataSourceRefreshPrerequisite","doc:\/\/Silo\/documentation\/Silo\/PrerequisiteError","doc:\/\/Silo\/documentation\/Silo\/DataSourceBuilder\/requires(_:)"]},{"title":"Guides","anchor":"Guides","generated":true,"identifiers":["doc:\/\/Silo\/documentation\/Silo\/Caching","doc:\/\/Silo\/documentation\/Silo\/ErrorHandling","doc:\/\/Silo\/documentation\/Silo\/TimeControls","doc:\/\/Silo\/documentation\/Silo\/Dependencies"]}],"identifier":{"url":"doc:\/\/Silo\/documentation\/Silo\/Prerequisites","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","title":"Prerequisites and Conditional Fetching","modules":[{"name":"Silo"}]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Silo/documentation/Silo/DataSourceBuilder/requires(_:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requires","kind":"identifier"},{"text":"(any ","kind":"text"},{"text":"DataSourceRefreshPrerequisite","kind":"typeIdentifier","preciseIdentifier":"s:4Silo29DataSourceRefreshPrerequisiteP"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"}],"type":"topic","abstract":[{"type":"text","text":"Add a prerequisite check that must pass before fetching."}],"url":"\/documentation\/silo\/datasourcebuilder\/requires(_:)","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSourceBuilder\/requires(_:)","title":"requires(_:)","kind":"symbol"},"doc://Silo/documentation/Silo/Caching":{"role":"article","type":"topic","abstract":[{"text":"Prevent redundant network calls by keeping fetched data valid for a configurable duration.","type":"text"}],"url":"\/documentation\/silo\/caching","identifier":"doc:\/\/Silo\/documentation\/Silo\/Caching","title":"Caching with TTL","kind":"article"},"doc://Silo/documentation/Silo/ErrorHandling":{"role":"article","identifier":"doc:\/\/Silo\/documentation\/Silo\/ErrorHandling","title":"Error Handling and Retry","abstract":[{"type":"text","text":"Decide what happens to cached data on failure, and configure automatic retry with backoff stra