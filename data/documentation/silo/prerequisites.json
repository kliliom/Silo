 {","        await NetworkMonitor.shared.isConnected","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"check()"},{"text":" method is ","type":"text"},{"type":"codeVoice","code":"async"},{"text":", so you can perform any awaitable check — including one that itself involves a network or system call.","type":"text"}]},{"anchor":"Adding-Prerequisites-to-a-Data-Source","type":"heading","text":"Adding Prerequisites to a Data Source","level":2},{"type":"paragraph","inlineContent":[{"text":"Chain ","type":"text"},{"type":"codeVoice","code":".requires(_:)"},{"text":" on the builder before ","type":"text"},{"type":"codeVoice","code":".build()"},{"text":". Multiple prerequisites are evaluated in order; the first failure stops the check and throws:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let profileSource = dataSource {","    try await api.fetchProfile()","} onError: { _ in .keep }",".requires(NetworkAvailable())",".requires(UserAuthenticated())",".build()"]},{"anchor":"Handling-Prerequisite-Failures","type":"heading","text":"Handling Prerequisite Failures","level":2},{"type":"paragraph","inlineContent":[{"text":"When a prerequisite fails, ","type":"text"},{"type":"codeVoice","code":"refresh()"},{"text":" throws a ","type":"text"},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/PrerequisiteError","isActive":true,"type":"reference"},{"text":". Catch it to distinguish prerequisite failures from network failures:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    try await profileSource.refresh()","} catch let error as PrerequisiteError {","    \/\/ Condition not met — show an appropriate message","    showOfflineBanner(error.message)","} catch {","    \/\/ Actual fetch error","    showErrorAlert(error)","}"]},{"anchor":"Common-Prerequisite-Implementations","type":"heading","text":"Common Prerequisite Implementations","level":2},{"anchor":"Network-Reachability","type":"heading","text":"Network Reachability","level":3},{"type":"codeListing","syntax":"swift","code":["import Network","","actor NetworkMonitor {","    static let shared = NetworkMonitor()","","    private let monitor = NWPathMonitor()","    private var isConnected = false","","    init() {","        monitor.pathUpdateHandler = { [weak self] path in","            Task { await self?.update(path.status == .satisfied) }","        }","        monitor.start(queue: .global(qos: .background))","    }","","    private func update(_ connected: Bool) { isConnected = connected }","    func checkConnected() async -> Bool { isConnected }","}","","struct NetworkAvailable: DataSourceRefreshPrerequisite {","    func check() async -> Bool {","        await NetworkMonitor.shared.checkConnected()","    }","}"]},{"anchor":"User-Authentication","type":"heading","text":"User Authentication","level":3},{"type":"codeListing","syntax":"swift","code":["struct UserAuthenticated: DataSourceRefreshPrerequisite {","    func check() async -> Bool {","        await AuthStore.shared.isLoggedIn","    }","}"]},{"anchor":"Feature-Flag","type":"heading","text":"Feature Flag","level":3},{"type":"codeListing","syntax":"swift","code":["struct FeatureEnabled: DataSourceRefreshPrerequisite {","    let flagName: String","","    func check() async -> Bool {","        await FeatureFlags.shared.isEnabled(flagName)","    }","}","","\/\/ Usage:","dataSource { ... }","    .requires(FeatureEnabled(flagName: \"newFeedAlgorithm\"))","    .build()"]},{"anchor":"Combined-Example","type":"heading","text":"Combined Example","level":3},{"type":"codeListing","syntax":"swift","code":["let secureDataSource = dataSource {","    try await api.fetchSecureData()","} onError: { error in","    error is AuthError ? .clear : .keep","}",".requires(NetworkAvailable())",".requires(UserAuthenticated())",".requires(FeatureEnabled(flagName: \"secureFeature\"))",".retry(maxAttempts: 2, delay: .seconds(1)) { error in","    error is URLError ? .retry : .stop","}",".ttl(.seconds(300))",".build()"]},{"type":"paragraph","inlineContent":[{"text":"In this configuration:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Network is checked first — no request attempted if offline"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Auth is verified second — no request if logged out"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Feature flag is checked third — no request if feature is off"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If all pass and the fetch fails, retry once more (2 attempts in total)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Cache results for 5 minutes"}],"type":"paragraph"}]}]},{"anchor":"Prerequisite-Evaluation-Order","type":"heading","text":"Prerequisite Evaluation Order","level":2},{"type":"paragraph","inlineContent":[{"text":"Prerequisites are evaluated sequentially in the order they were added. Evaluation stops at the first failure — subsequent prerequisites are not checked.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".requires(NetworkAvailable())   \/\/ Checked first",".requires(UserAuthenticated())  \/\/ Only checked if network is available",".requires(FeatureEnabled(...))  \/\/ Only checked if both above pass"]},{"anchor":"Prerequisites-and-Retry","type":"heading","text":"Prerequisites and Retry","level":2},{"type":"paragraph","inlineContent":[{"text":"Prerequisite checks happen ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"text":" the retry loop. If a prerequisite fails, the fetch is not attempted — and the retry strategy never kicks in. This is intentional: retrying a fetch when the prerequisite is already known to be unmet would be wasteful.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you need to retry until a prerequisite p