{"sections":[],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"Error handling in Silo is split across two distinct types, each with its own responsibility:","type":"text"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Used in"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Controls"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Silo\/documentation\/Silo\/FetchErrorAction","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Top-level "},{"type":"codeVoice","code":"onError"},{"type":"text","text":" closure"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cache contents after all retries are exhausted"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Silo\/documentation\/Silo\/RetryErrorAction","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Per-attempt "},{"type":"codeVoice","code":"onError"},{"type":"text","text":" in "},{"type":"codeVoice","code":".retry()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether to attempt the next retry"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"This separation keeps each handler to one job: the retry ","type":"text"},{"type":"codeVoice","code":"onError"},{"text":" decides how hard to fight before giving up; the top-level ","type":"text"},{"type":"codeVoice","code":"onError"},{"text":" decides what the user sees after failure. Cache disposition lives in exactly one place.","type":"text"}],"type":"paragraph"},{"anchor":"The-Top-Level-onError-Handler","type":"heading","level":2,"text":"The Top-Level `onError` Handler"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"onError"},{"text":" closure on ","type":"text"},{"type":"codeVoice","code":"dataSource()"},{"text":" receives the error thrown after all retries are exhausted and returns an ","type":"text"},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/FetchErrorAction","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let profileSource = dataSource {","    try await api.fetchProfile()","} onError: { error in","    switch error {","    case is NetworkOfflineError:","        return .keep   \/\/ Show stale profile while offline","    case is AuthError:","        return .clear  \/\/ Wipe sensitive data on auth failure","    default:","        return .keep","    }","}",".build()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"identifier":"doc:\/\/Silo\/documentation\/Silo\/FetchErrorAction","type":"reference","isActive":true},{"text":" has two cases:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cache result"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use when","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".keep"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unchanged"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stale data is better than nothing"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".clear"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replaced with empty value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stale data is wrong or sensitive"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The error is always re-thrown after the handler runs, so callers can still ","type":"text"},{"type":"codeVoice","code":"catch"},{"text":" it:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["do {","    try await profileSource.refresh()","} catch let error as AuthError {","    showLoginScreen()","} catch {","    showErrorBanner(error.localizedDescription)","}"]},{"level":2,"type":"heading","text":"Simple Retry","anchor":"Simple-Retry"},{"type":"paragraph","inlineContent":[{"text":"Make up to ","type":"text"},{"type":"codeVoice","code":"maxAttempts"},{"text":" fetch attempts in total — the initial attempt counts, so ","type":"text"},{"type":"codeVoice","code":"maxAttempts: 3"},{"text":" means one initial attempt plus up to two retries — with a constant delay between attempts:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["dataSource { ... }","    .retry(maxAttempts: 3, delay: .seconds(1))","    .build()","\/\/ Attempt 1 → fail → wait 1s → Attempt 2 → fail → wait 1s → Attempt 3 → fail → onError"]},{"level":2,"type":"heading","text":"Retry with Per-Attempt Error Gating","anchor":"Retry-with-Per-Attempt-Error-Gating"},{"type":"paragraph","inlineContent":[{"text":"Supply a closure returning ","type":"text"},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/RetryErrorAction","type":"reference","isActive":true},{"text":" to decide per-error whether to keep retrying:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["dataSource { ... }","    .retry(maxAttempts: 3, delay: .seconds(1)) { error in","        switch error {","        case is URLError:       return .retry  \/\/ Network error — try again","        case is DecodingError:  return .stop   \/\/ Parsing error — give up immediately","        default:                return .stop","        }","    }","    .build()"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Silo\/documentation\/Silo\/RetryErrorAction","type":"reference","isActive":true},{"text":" has two cases:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use when"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".retry","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wait the delay, then attempt again"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Error is transient and worth retrying"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".stop"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stop retrying; defer cache decision to top-level "},{"code":"onError","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Error is permanent; further retries would waste effort"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":".stop"},{"type":"text","text":" is returned, retrying halts immediately and the error flows to the top-level "},{"type":"codeVoice","code":"onError"},{"type":"text","text":" handler, which decides whether to keep or clear the cache."}]},{"anchor":"Exponential-Backoff","type":"heading","level":2,"text":"Exponential Backoff"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each retry waits exponentially longer than the previous. This is the right choice for rate-limited APIs or servers under load:"}]},{"type":"codeListing","syntax":"swift","code":["dataSource { ... }","    .retry(strategy: .exponentialBackoff(","        maxAttempts: 5,","        initialDelay: .seconds(1),","        multiplier: 2.0","    ))","    .build()","\/\/ Delays: 1s → 2s → 4s → 8s → onError"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cap the maximum wait to avoid very long delays:"}]},{"code":[".retry(strategy: .exponentialBackoff(","    maxAttempts: 7,","    initialDelay: .seconds(1),","    multiplier: 2.0,","    maxDelay: .seconds(30)","))","\/\/ Delays: 1s → 2s → 4s → 8s → 16s → 30s (capped) → onError"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","anchor":"Linear-Backoff","text":"Linear Backoff"},{"inlineContent":[{"type":"text","text":"Each retry adds a fixed increment to the previous delay:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".retry(strategy: .linearBackoff(","    maxAttempts: 4,","    initialDelay: .seconds(2),","    increment: .seconds(3)","))","\/\/ Delays: 2s → 5s → 8s → onError"]},{"anchor":"Custom-Retry-Strategy","type":"heading","text":"Custom Retry Strategy","level":2},{"inlineContent":[{"type":"text","text":"Build any delay pattern with a "},{"type":"codeVoice","code":"delayCalculator"},{"type":"text","text":" closure:"}],"type":"paragraph"},{"code":["\/\/ Jittered exponential backoff","let jitteredBackoff = RetryStrategy.custom(maxAttempts: 5) { attempt in","    let base = pow(2.0, Double(attempt - 1))","    let jitter = Double.random(in: 0.8...1.2)","    return .seconds(base * jitter)","}","","dataSource { ... }","    .retry(strategy: jitteredBackoff)","    .build()"],"type":"codeListing","syntax":"swift"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"delayCalculator"},{"text":" closure is called after attempt ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" fails ("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" ranges from 1 to ","type":"text"},{"type":"codeVoice","code":"maxAttempts - 1"},{"type":"text","text":", where 1 is the initial attempt) and returns the delay to wait before attempt "},{"type":"emphasis","inlineContent":[{"text":"n + 1","type":"text"}]},{"text":". So with ","type":"text"},{"type":"codeVoice","code":"maxAttempts: 5"},{"text":" it is called at most 4 times, with arguments 1 through 4.","type":"text"}]}]},{"anchor":"Combining-Strategy-and-Error-Gating","type":"heading","level":2,"text":"Combining Strategy and Error Gating"},{"code":["dataSource { ... }","    .retry(","        strategy: .exponentialBackoff(maxAttempts: 4, initialDelay: .seconds(1)),","        onError: { error in","            if error is RateLimitError   { return .retry }","            if error is ServerError      { return .retry }","            return .stop  \/\/ Client errors and decoding failures: stop retrying","        }","    )","    .build()"],"type":"codeListing","syntax":"swift"},{"anchor":"Retry-Tolerance","type":"heading","level":2,"text":"Retry Tolerance"},{"inlineContent":[{"type":"text","text":"All retry variants accept a "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" parameter to allow "},{"code":"Task.sleep","type":"codeVoice"},{"type":"text","text":" to fire slightly late, improving battery efficiency:"}],"type":"paragraph"},{"code":[".retry(maxAttempts: 3, delay: .seconds(5), tolerance: .milliseconds(500))"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Interaction-Between-the-Two-onError-Handlers","text":"Interaction Between the Two `onError` Handlers","type":"heading"},{"code":["fetch() throws","    │","    └── retry onError? ──.retry──► wait delay ──► fetch() [next attempt]","                │                                       │","                │         ◄──── max attempts reached ───┘","                │","                └──.stop ──► stop retrying","                                    │","                                    ▼","                           top-level onError","                           ├── .keep  → preserve cache","                           └── .clear → emit empty value","                                    │","                                    ▼","                           error re-thrown to caller"],"syntax":null,"type":"codeListing"}],"kind":"content"}],"abstract":[{"type":"text","text":"Decide what happens to cached data on failure, and configure automatic retry with backoff strategies."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Silo\/documentation\/Silo\/ErrorHandling"},"metadata":{"roleHeading":"Article","title":"Error Handling and Retry","modules":[{"name":"Silo"}],"role":"article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/silo\/errorhandling"]}],"hierarchy":{"paths":[["doc:\/\/Silo\/documentation\/Silo"]]},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Silo\/documentation\/Silo\/Caching","doc:\/\/Silo\/documentation\/Silo\/FetchErrorAction","doc:\/\/Silo\/documentation\/Silo\/RetryErrorAction","doc:\/\/Silo\/documentation\/Silo\/RetryStrategy","doc:\/\/Silo\/documentation\/Silo\/DataSource\/refresh(clear:)"],"anchor":"Related-Documentation"},{"title":"Guides","identifiers":["doc:\/\/Silo\/documentation\/Silo\/Caching","doc:\/\/Silo\/documentation\/Silo\/TimeControls","doc:\/\/Silo\/documentation\/Silo\/Dependencies","doc:\/\/Silo\/documentation\/Silo\/Prerequisites"],"generated":true,"anchor":"Guides"}],"references":{"doc://Silo/documentation/Silo/DataSource":{"navigatorTitle":[{"kind":"identifier","text":"DataSource"}],"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DataSource"}],"abstract":[{"text":"Manages asynchronous data fetching, caching, and reactive streaming for a single value type.","type":"text"}],"role":"symbol","title":"DataSource","url":"\/documentation\/silo\/datasource","kind":"symbol","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource"},"doc://Silo/documentation/Silo/Caching":{"title":"Caching with TTL","kind":"article","role":"article","url":"\/documentation\/silo\/caching","abstract":[{"text":"Prevent redundant network calls by keeping fetched data valid for a configurable duration.","type":"text"}],"identifier":"doc:\/\/Silo\/documentation\/Silo\/Caching","type":"topic"},"doc://Silo/documentation/Silo/RetryStrategy":{"abstract":[{"text":"Defines how many times to retry a failed fetch and how long to wait between attempts.","type":"text"}],"type":"topic","identifier":"doc:\/\/Silo\/documentation\/Silo\/RetryStrategy","title":"RetryStrategy","url":"\/documentation\/silo\/retrystrategy","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"RetryStrategy"}],"navigatorTitle":[{"kind":"identifier","text":"RetryStrategy"}]},"doc://Silo/documentation/Silo":{"type":"topic","abstract":[{"text":"Reactive async data management for Swift 6 — fetch, cache, and stream data with zero dependencies.","type":"text"}],"role":"collection","title":"Silo","url":"\/documentation\/silo","kind":"symbol","identifier":"doc:\/\/Silo\/documentation\/Silo"},"doc://Silo/documentation/Silo/Prerequisites":{"title":"Prerequisites and Conditional Fetching","kind":"article","role":"article","url":"\/documentation\/silo\/prerequisites","abstract":[{"text":"Gate fetches on runtime conditions such as network availability or user authentication state.","type":"text"}],"identifier":"doc:\/\/Silo\/documentation\/Silo\/Prerequisites","type":"topic"},"doc://Silo/documentation/Silo/RetryErrorAction":{"navigatorTitle":[{"text":"RetryErrorAction","kind":"identifier"}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RetryErrorAction","kind":"identifier"}],"abstract":[{"text":"The action a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource"},{"text":" should take after an individual retry attempt fails.","type":"text"}],"role":"symbol","title":"RetryErrorAction","identifier":"doc:\/\/Silo\/documentation\/Silo\/RetryErrorAction","kind":"symbol","url":"\/documentation\/silo\/retryerroraction"},"doc://Silo/documentation/Silo/DataSource/refresh(clear:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"refresh"},{"kind":"text","text":"("},{"kind":"externalParam","text":"clear"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Value"}],"title":"refresh(clear:)","kind":"symbol","role":"symbol","url":"\/documentation\/silo\/datasource\/refresh(clear:)","abstract":[{"text":"Fetches new data, updating the cache and notifying all stream subscribers on success.","type":"text"}],"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/refresh(clear:)","type":"topic"},"doc://Silo/documentation/Silo/FetchErrorAction":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FetchErrorAction"}],"title":"FetchErrorAction","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"FetchErrorAction"}],"role":"symbol","url":"\/documentation\/silo\/fetcherroraction","abstract":[{"text":"The action a ","type":"text"},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource","type":"reference","isActive":true},{"text":" should take on a fetch error.","type":"text"}],"identifier":"doc:\/\/Silo\/documentation\/Silo\/FetchErrorAction","type":"topic"},"doc://Silo/documentation/Silo/TimeControls":{"title":"Time Controls","kind":"article","role":"article","url":"\/documentation\/silo\/timecontrols","abstract":[{"text":"Limit fetch frequency with throttling, smooth out bursts with debouncing, and keep data current with auto-refresh.","type":"text"}],"identifier":"doc:\/\/Silo\/documentation\/Silo\/TimeControls","type":"topic"},"doc://Silo/documentation/Silo/Dependencies":{"url":"\/documentation\/silo\/dependencies","identifier":"doc:\/\/Silo\/documentation\/Silo\/Dependencies","type":"topic","kind":"article","role":"article","abstract":[{"type":"text","text":"Automatically re-fetch data whenever upstream async stream values change."}],"title":"Dependencies and Reactive Fetching"}}}