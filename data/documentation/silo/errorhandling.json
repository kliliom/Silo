{"hierarchy":{"paths":[["doc:\/\/Silo\/documentation\/Silo"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Silo\/documentation\/Silo\/ErrorHandling"},"metadata":{"title":"Error Handling and Retry","role":"article","roleHeading":"Article","modules":[{"name":"Silo"}]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Error handling in Silo is split across two distinct types, each with its own responsibility:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Used in","type":"text"}]}],[{"inlineContent":[{"text":"Controls","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Silo\/documentation\/Silo\/FetchErrorAction","isActive":true}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Top-level ","type":"text"},{"code":"onError","type":"codeVoice"},{"text":" closure","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cache contents after all retries are exhausted","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Silo\/documentation\/Silo\/RetryErrorAction","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"Per-attempt ","type":"text"},{"code":"onError","type":"codeVoice"},{"text":" in ","type":"text"},{"type":"codeVoice","code":".retry()"}]}],[{"type":"paragraph","inlineContent":[{"text":"Whether to attempt the next retry","type":"text"}]}]]]},{"inlineContent":[{"text":"This separation keeps each handler to one job: the retry ","type":"text"},{"code":"onError","type":"codeVoice"},{"text":" decides how hard to fight before giving up; the top-level ","type":"text"},{"code":"onError","type":"codeVoice"},{"type":"text","text":" decides what the user sees after failure. Cache disposition lives in exactly one place."}],"type":"paragraph"},{"text":"The Top-Level `onError` Handler","level":2,"anchor":"The-Top-Level-onError-Handler","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"onError"},{"type":"text","text":" closure on "},{"type":"codeVoice","code":"dataSource()"},{"type":"text","text":" receives the error thrown after all retries are exhausted and returns an "},{"type":"reference","identifier":"doc:\/\/Silo\/documentation\/Silo\/FetchErrorAction","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let profileSource = dataSource {","    try await api.fetchProfile()","} onError: { error in","    switch error {","    case is NetworkOfflineError:","        return .keep   \/\/ Show stale profile while offline","    case is AuthError:","        return .clear  \/\/ Wipe sensitive data on auth failure","    default:","        return .keep","    }","}",".build()"]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Silo\/documentation\/Silo\/FetchErrorAction"},{"type":"text","text":" has two cases:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cache result","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Use when"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".keep","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Unchanged","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Stale data is better than nothing","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".clear","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Replaced with empty value"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Stale data is wrong or sensitive"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"The error is always re-thrown after the handler runs, so callers can still "},{"type":"codeVoice","code":"catch"},{"type":"text","text":" it:"}],"type":"paragraph"},{"code":["do {","    try await profileSource.refresh()","} catch let error as AuthError {","    showLoginScreen()","} catch {","    showErrorBanner(error.localizedDescription)","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Simple Retry","anchor":"Simple-Retry"},{"inlineContent":[{"text":"Make up to ","type":"text"},{"type":"codeVoice","code":"maxAttempts"},{"type":"text","text":" fetch attempts in total — the initial attempt counts, so "},{"code":"maxAttempts: 3","type":"codeVoice"},{"text":" means one initial attempt plus up to two retries — with a constant delay between attempts:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["dataSource { ... }","    .retry(maxAttempts: 3, delay: .seconds(1))","    .build()","\/\/ Attempt 1 → fail → wait 1s → Attempt 2 → fail → wait 1s → Attempt 3 → fail → onError"],"syntax":"swift"},{"type":"heading","level":2,"text":"Retry with Per-Attempt Error Gating","anchor":"Retry-with-Per-Attempt-Error-Gating"},{"inlineContent":[{"type":"text","text":"Supply a closure returning "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Silo\/documentation\/Silo\/RetryErrorAction"},{"type":"text","text":" to decide per-error whether to keep retrying:"}],"type":"paragraph"},{"type":"codeListing","code":["dataSource { ... }","    .retry(maxAttempts: 3, delay: .seconds(1)) { error in","        switch error {","        case is URLError:       return .retry  \/\/ Network error — try again","        case is DecodingError:  return .stop   \/\/ Parsing error — give up immediately","        default:                return .stop","        }","    }","    .build()"],"syntax":"swift"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Silo\/documentation\/Silo\/RetryErrorAction","isActive":true},{"text":" has two cases:","type":"text"}],"type":"paragraph"},{"type":"table","rows":[[[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Effect","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use when"}]}]],[[{"inlineContent":[{"code":".retry","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Wait the delay, then attempt again"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Error is transient and worth retrying","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".stop","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Stop retrying; defer cache decision to top-level ","type":"text"},{"type":"codeVoice","code":"onError"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Error is permanent; further retries would waste effort","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":".stop"},{"type":"text","text":" is returned, retrying halts immediately and the error flows to the top-level "},{"type":"codeVoice","code":"onError"},{"type":"text","text":" handler, which decides whether to keep or clear the cache."}],"type":"paragraph"},{"level":2,"text":"Exponential Backoff","anchor":"Exponential-Backoff","type":"heading"},{"inlineContent":[{"type":"text","text":"Each retry waits exponentially longer than the previous. This is the right choice for rate-limited APIs or servers under load:"}],"type":"paragraph"},{"code":["dataSource { ... }","    .retry(strategy: .exponentialBackoff(","        maxAttempts: 5,","        initialDelay: .seconds(1),","        multiplier: 2.0","    ))","    .build()","\/\/ Delays: 1s → 2s → 4s → 8s → onError"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Cap the maximum wait to avoid very long delays:"}],"type":"paragraph"},{"code":[".retry(strategy: .exponentialBackoff(","    maxAttempts: 7,","    initialDelay: .seconds(1),","    multiplier: 2.0,","    maxDelay: .seconds(30)","))","\/\/ Delays: 1s → 2s → 4s → 8s → 16s → 30s (capped) → onError"],"type":"codeListing","syntax":"swift"},{"text":"Linear Backoff","anchor":"Linear-Backoff","level":2,"type":"heading"},{"inlineContent":[{"text":"Each retry adds a fixed increment to the previous delay:","type":"text"}],"type":"paragraph"},{"code":[".retry(strategy: .linearBackoff(","    maxAttempts: 4,","    initialDelay: .seconds(2),","    increment: .seconds(3)","))","\/\/ Delays: 2s → 5s → 8s → onError"],"type":"codeListing","syntax":"swift"},{"text":"Custom Retry Strategy","anchor":"Custom-Retry-Strategy","level":2,"type":"heading"},{"inlineContent":[{"text":"Build any delay pattern with a ","type":"text"},{"code":"delayCalculator","type":"codeVoice"},{"text":" closure:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Jittered exponential backoff","let jitteredBackoff = RetryStrategy.custom(maxAttempts: 5) { attempt in","    let base = pow(2.0, Double(attempt - 1))","    let jitter = Double.random(in: 0.8...1.2)","    return .seconds(base * jitter)","}","","dataSource { ... }","    .retry(strategy: jitteredBackoff)","    .build()"],"type":"codeListing","syntax":"swift"},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"delayCalculator"},{"type":"text","text":" closure is called after attempt "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" fails ("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" ranges from 1 to "},{"type":"codeVoice","code":"maxAttempts - 1"},{"type":"text","text":", where 1 is the initial attempt) and returns the delay to wait before attempt "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n + 1"}]},{"type":"text","text":". So with "},{"type":"codeVoice","code":"maxAttempts: 5"},{"type":"text","text":" it is called at most 4 times, with arguments 1 through 4."}],"type":"paragraph"}]},{"level":2,"text":"Combining Strategy and Error Gating","anchor":"Combining-Strategy-and-Error-Gating","type":"heading"},{"syntax":"swift","code":["dataSource { ... }","    .retry(","        strategy: .exponentialBackoff(maxAttempts: 4, initialDelay: .seconds(1)),","        onError: { error in","            if error is RateLimitError   { return .retry }","            if error is ServerError      { return .retry }","            return .stop  \/\/ Client errors and decoding failures: stop retrying","        }","    )","    .build()"],"type":"codeListing"},{"level":2,"text":"Retry Tolerance","anchor":"Retry-Tolerance","type":"heading"},{"inlineContent":[{"type":"text","text":"All retry variants accept a "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" parameter to allow "},{"type":"codeVoice","code":"Task.sleep"},{"type":"text","text":" to fire slightly late, improving battery efficiency:"}],"type":"paragraph"},{"syntax":"swift","code":[".retry(maxAttempts: 3, delay: .seconds(5), tolerance: .milliseconds(500))"],"type":"codeListing"},{"level":2,"text":"Interaction Between the Two `onError` Handlers","anchor":"Interaction-Between-the-Two-onError-Handlers","type":"heading"},{"syntax":null,"code":["fetch() throws","    │","    └── retry onError? ──.retry──► wait delay ──► fetch() [next attempt]","                │                                       │","                │         ◄──── max attempts reached ───┘","                │","                └──.stop ──► stop retrying","                                    │","                                    ▼","                           top-level onError","                           ├── .keep  → preserve cache","                           └── .clear → emit empty value","                                    │","                                    ▼","                           error re-thrown to caller"],"type":"codeListing"}]}],"variants":[{"paths":["\/documentation\/silo\/errorhandling"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Decide what happens to cached data on failure, and configure automatic retry with backoff strategies."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Silo\/documentation\/Silo\/Caching","doc:\/\/Silo\/documentation\/Silo\/FetchErrorAction","doc:\/\/Silo\/documentation\/Silo\/RetryErrorAction","doc:\/\/Silo\/documentation\/Silo\/RetryStrategy","doc:\/\/Silo\/documentation\/Silo\/DataSource\/refresh(clear:)"],"title":"Related Documentation","anchor":"Related-Documentation"},{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Silo\/documentation\/Silo\/Caching","doc:\/\/Silo\/documentation\/Silo\/TimeControls","doc:\/\/Silo\/documentation\/Silo\/Dependencies","doc:\/\/Silo\/documentation\/Silo\/Prerequisites"]}],"kind":"article","references":{"doc://Silo/documentation/Silo/Prerequisites":{"abstract":[{"text":"Gate fetches on runtime conditions such as network availability or user authentication state.","type":"text"}],"kind":"article","role":"article","type":"topic","title":"Prerequisites and Conditional Fetching","url":"\/documentation\/silo\/prerequisites","identifier":"doc:\/\/Silo\/documentation\/Silo\/Prerequisites"},"doc://Silo/documentation/Silo/DataSource/refresh(clear:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"refresh"},{"kind":"text","text":"("},{"kind":"externalParam","text":"clear"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"text":" -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier"}],"type":"topic","abstract":[{"type":"text","text":"Fetches new data, updating the cache and notifying all stream subscribers on success."}],"url":"\/documentation\/silo\/datasource\/refresh(clear:)","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/refresh(clear:)","title":"refresh(clear:)","kind":"symbol"},"doc://Silo/documentation/Silo/RetryErrorAction":{"abstract":[{"text":"The action a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource","type":"reference"},{"text":" should take after an individual retry attempt fails.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"RetryErrorAction"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RetryErrorAction"}],"type":"topic","title":"RetryErrorAction","url":"\/documentation\/silo\/retryerroraction","identifier":"doc:\/\/Silo\/documentation\/Silo\/RetryErrorAction"},"doc://Silo/documentation/Silo/TimeControls":{"abstract":[{"type":"text","text":"Limit fetch frequency with throttling, smooth out bursts with debouncing, and keep data current with auto-refresh."}],"kind":"article","url":"\/documentation\/silo\/timecontrols","identifier":"doc:\/\/Silo\/documentation\/Silo\/TimeControls","title":"Time Controls","type":"topic","role":"article"},"doc://Silo/documentation/Silo/Dependencies":{"role":"article","identifier":"doc:\/\/Silo\/documentation\/Silo\/Dependencies","title":"Dependencies and Reactive Fetching","abstract":[{"text":"Automatically re-fetch data whenever upstream async stream values change.","type":"text"}],"type":"topic","kind":"article","url":"\/documentation\/silo\/dependencies"},"doc://Silo/documentation/Silo":{"abstract":[{"type":"text","text":"Reactive async data management for Swift 6 — fetch, cache, and stream data with zero dependencies."}],"kind":"symbol","role":"collection","type":"topic","title":"Silo","url":"\/documentation\/silo","identifier":"doc:\/\/Silo\/documentation\/Silo"},"doc://Silo/documentation/Silo/DataSource":{"title":"DataSource","url":"\/documentation\/silo\/datasource","abstract":[{"type":"text","text":"Manages asynchronous data fetching, caching, and reactive streaming for a single value type."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DataSource"}],"type":"topic","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DataSource"}]},"doc://Silo/documentation/Silo/RetryStrategy":{"abstract":[{"text":"Defines how many times to retry a failed fetch and how long to wait between attempts.","type":"text"}],"navigatorTitle":[{"text":"RetryStrategy","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RetryStrategy","kind":"identifier"}],"type":"topic","title":"RetryStrategy","url":"\/documentation\/silo\/retrystrategy","identifier":"doc:\/\/Silo\/documentation\/Silo\/RetryStrategy"},"doc://Silo/documentation/Silo/Caching":{"role":"article","type":"topic","abstract":[{"text":"Prevent redundant network calls by keeping fetched data valid for a configurable duration.","type":"text"}],"url":"\/documentation\/silo\/caching","identifier":"doc:\/\/Silo\/documentation\/Silo\/Caching","title":"Caching with TTL","kind":"article"},"doc://Silo/documentation/Silo/FetchErrorAction":{"fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"FetchErrorAction"}],"navigatorTitle":[{"text":"FetchErrorAction","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Silo\/documentation\/Silo\/FetchErrorAction","title":"FetchErrorAction","abstract":[{"text":"The action a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource","type":"reference"},{"type":"text","text":" should take on a fetch error."}],"type":"topic","kind":"symbol","url":"\/documentation\/silo\/fetcherroraction"}}}