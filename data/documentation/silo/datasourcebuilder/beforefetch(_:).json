hed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example:"}]},{"syntax":"swift","code":["dataSource {","    try await api.fetchProfile()","} onError: { error in","    if error is BeforeFetchError { return .keep }","    return .clear","}",".beforeFetch { try await authSource.refresh() }",".build()"],"type":"codeListing"}]}],"references":{"doc://Silo/documentation/Silo/DataSource/cancelRefresh(clear:)":{"abstract":[{"text":"Cancel any in-flight fetch operation.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancelRefresh"},{"kind":"text","text":"("},{"kind":"externalParam","text":"clear"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":")"}],"type":"topic","title":"cancelRefresh(clear:)","url":"\/documentation\/silo\/datasource\/cancelrefresh(clear:)","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/cancelRefresh(clear:)"},"doc://Silo/documentation/Silo/DataSourceBuilder/beforeFetch(_:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"beforeFetch"},{"kind":"text","text":"(() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"}],"type":"topic","abstract":[{"type":"text","text":"Register an async closure to run before each fetch."}],"url":"\/documentation\/silo\/datasourcebuilder\/beforefetch(_:)","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSourceBuilder\/beforeFetch(_:)","title":"beforeFetch(_:)","kind":"symbol"},"doc://Silo/documentation/Silo":{"abstract":[{"type":"text","text":"Reactive async data management for Swift 6 — fetch, cache, and stream data with zero dependencie