{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/silo\/timecontrols"]}],"hierarchy":{"paths":[["doc:\/\/Silo\/documentation\/Silo"]]},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Silo\/documentation\/Silo\/Caching","doc:\/\/Silo\/documentation\/Silo\/DataSource\/stopAutoRefresh()","doc:\/\/Silo\/documentation\/Silo\/DataSource\/resumeAutoRefresh()","doc:\/\/Silo\/documentation\/Silo\/DataSource\/restartAutoRefresh(immediate:)"],"anchor":"Related-Documentation"},{"title":"Guides","identifiers":["doc:\/\/Silo\/documentation\/Silo\/Caching","doc:\/\/Silo\/documentation\/Silo\/ErrorHandling","doc:\/\/Silo\/documentation\/Silo\/Dependencies","doc:\/\/Silo\/documentation\/Silo\/Prerequisites"],"generated":true,"anchor":"Guides"}],"abstract":[{"text":"Limit fetch frequency with throttling, smooth out bursts with debouncing, and keep data current with auto-refresh.","type":"text"}],"metadata":{"title":"Time Controls","roleHeading":"Article","modules":[{"name":"Silo"}],"role":"article"},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Silo provides three complementary time-based policies. Each addresses a different problem:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Policy"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Problem it solves"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Applied at"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Throttle","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Prevents too many fetches in a short window"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Per fetch call"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Debounce","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Waits for rapid calls to settle before fetching"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Per fetch call"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Auto-refresh","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keeps data current without manual triggers"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Background"}]}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All three can be combined with TTL caching — if cached data is still fresh, neither throttle nor auto-refresh will trigger an actual network call."}]},{"text":"Throttle","level":2,"type":"heading","anchor":"Throttle"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Throttling enforces a minimum time between fetches. This is the right tool when a fetch can be triggered by rapid user interaction (button taps, scroll-driven prefetching) and you want a hard rate limit regardless of how many calls arrive."}]},{"syntax":"swift","type":"codeListing","code":["let refreshSource = dataSource {","    try await api.fetchUpdates()","} onError: { _ in .keep }",".throttle(.seconds(2)) \/\/ At most one fetch per 2 seconds",".build()"]},{"text":"Drop vs. Queue Mode","level":3,"type":"heading","anchor":"Drop-vs-Queue-Mode"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two behaviours are available, selected with the "},{"type":"codeVoice","code":"last"},{"type":"text","text":" parameter:"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Drop mode"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"last: false"},{"type":"text","text":", the default): the first call in a window fetches immediately. Subsequent calls during the window return the cached value without fetching. The pending calls are silently discarded when the window ends."}]},{"type":"codeListing","code":[".throttle(.seconds(2))         \/\/ First call goes through; others return cache"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Queue mode"}],"type":"strong"},{"text":" (","type":"text"},{"type":"codeVoice","code":"last: true"},{"text":"): the first call fetches. Additional calls during the window are deferred. When the window expires, the ","type":"text"},{"inlineContent":[{"text":"most recent","type":"text"}],"type":"emphasis"},{"type":"text","text":" queued call is executed."}]},{"type":"codeListing","code":[".throttle(.seconds(2), last: true) \/\/ Last caller always gets fresh data eventually"],"syntax":"swift"},{"name":"Note","type":"aside","content":[{"inlineContent":[{"text":"Throttling only applies while cached data exists. When the source is empty — for example after the previous fetch failed — ","type":"text"},{"type":"codeVoice","code":"refresh()"},{"text":" always proceeds to fetch, so a throttled drop can never return the empty value as if it were fetched data.","type":"text"}],"type":"paragraph"}],"style":"note"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"When to choose:","type":"text"}],"type":"strong"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[]}],[{"inlineContent":[{"text":"Drop (","type":"text"},{"type":"codeVoice","code":"last: false"},{"text":")","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Queue ("},{"code":"last: true","type":"codeVoice"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Manual refresh button"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✓ First tap always works"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"text":"Search-as-you-type","type":"text"}]}],[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"text":"✓ Last query always resolves","type":"text"}]}]],[[{"inlineContent":[{"text":"Sensor polling","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✓ Discard intermediate readings","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Form auto-save"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"text":"✓ Latest input always saves","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"level":3,"anchor":"Throttle-Tolerance","text":"Throttle Tolerance","type":"heading"},{"inlineContent":[{"text":"Allow the wait timer in queue mode to fire slightly late:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".throttle(.seconds(2), last: true, tolerance: .milliseconds(200))"]},{"level":2,"anchor":"Debounce","text":"Debounce","type":"heading"},{"inlineContent":[{"text":"Debouncing delays execution until calls have stopped arriving for a specified quiet period. Each ","type":"text"},{"code":"refresh()","type":"codeVoice"},{"text":" call resets the timer. Only after the full quiet period elapses does the actual fetch happen.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let searchSource = dataSource { query in","    try await api.search(query: query)","} onError: { _ in .keep }","emptyValue: { [] }",".debounce(.milliseconds(350)) \/\/ Wait 350ms of silence before fetching",".build()"]},{"inlineContent":[{"text":"If ","type":"text"},{"code":"refresh()","type":"codeVoice"},{"text":" is called three times in 200ms, the first two calls are cancelled and only the third one — after 350ms of silence — triggers a fetch.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"250–400ms is a sweet spot for search debouncing. Values under 150ms feel laggy; values over 500ms feel slow.","type":"text"}],"type":"paragraph"}],"style":"tip","type":"aside","name":"Tip"},{"level":3,"anchor":"Debounce-vs-Throttle-Decision-Guide","text":"Debounce vs. Throttle Decision Guide","type":"heading"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Situation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Search-as-you-type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Debounce — wait for the user to pause","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Refresh button taps","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Throttle — first tap always works","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Rapid scroll triggers","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Throttle — drop intermediate positions","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Text field auto-complete","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Debounce — only query after typing stops","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Pull-to-refresh gesture","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Neither — call ","type":"text"},{"type":"codeVoice","code":"refresh(clear: true)"},{"text":" directly","type":"text"}],"type":"paragraph"}]]]},{"level":3,"anchor":"Debounce-and-Cancellation","text":"Debounce and Cancellation","type":"heading"},{"inlineContent":[{"text":"Callers that are cancelled by a subsequent ","type":"text"},{"code":"refresh()","type":"codeVoice"},{"text":" call during the debounce window receive a ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":". Handle this if needed:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    try await searchSource.refresh()","} catch is CancellationError {","    \/\/ Expected — this call was superseded by a newer one","} catch {","    showError(error)","}"]},{"level":2,"anchor":"Auto-Refresh","text":"Auto-Refresh","type":"heading"},{"inlineContent":[{"text":"Auto-refresh periodically calls ","type":"text"},{"code":"refresh()","type":"codeVoice"},{"text":" at a fixed interval while the data source has at least one active subscriber to ","type":"text"},{"code":"values","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"valueWithState","type":"codeVoice"},{"text":". When the first subscriber appears, an immediate refresh is triggered before the first interval elapses — so data is never stale on first observation. The timer stops automatically when the last subscriber terminates.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let stockSource = dataSource {","    try await api.fetchPrice(ticker: \"AAPL\")","} onError: { _ in .keep }",".autoRefresh(.seconds(10)) \/\/ Poll every 10 seconds while being observed",".build()"]},{"syntax":"swift","type":"codeListing","code":["\/\/ Timer starts here:","for await price in stockSource.values {","    priceLabel.text = price.formatted(.currency(code: \"USD\"))","} \/\/ Timer stops here (stream ended)"]},{"inlineContent":[{"text":"This subscriber-driven design means no background work happens when the UI is off-screen.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Auto-refresh calls ","type":"text"},{"type":"codeVoice","code":"refresh()"},{"text":" internally, so all configured policies still apply — TTL, throttle, and debounce all take effect. If data is fresh within its TTL, an auto-refresh call is a no-op that returns the cached value.","type":"text"}],"type":"paragraph"}],"style":"important","type":"aside","name":"Important"},{"level":3,"anchor":"Managing-Auto-Refresh-Manually","text":"Managing Auto-Refresh Manually","type":"heading"},{"inlineContent":[{"text":"Pause and resume the timer explicitly, for example when the app enters the background:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppDelegate \/ SceneDelegate","func sceneDidEnterBackground(_ scene: UIScene) {","    stockSource.stopAutoRefresh()","}","","func sceneWillEnterForeground(_ scene: UIScene) {","    stockSource.resumeAutoRefresh()","}"]},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/resumeAutoRefresh()"},{"text":" resumes the timer and triggers an immediate refresh, ensuring data is not stale for a full interval after the app returns to the foreground.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To reset the interval from zero (and optionally fire an immediate refresh):","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Reset the 10-second cycle without an immediate fetch","await stockSource.restartAutoRefresh(immediate: false)","","\/\/ Reset and fetch right now (useful when returning from background)","await stockSource.restartAutoRefresh(immediate: true)"]},{"level":3,"anchor":"Auto-Refresh-and-Battery","text":"Auto-Refresh and Battery","type":"heading"},{"inlineContent":[{"text":"Set a tolerance to allow the OS to coalesce wake-ups from multiple timers, reducing CPU wake frequency:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".autoRefresh(.seconds(60), tolerance: .seconds(5))","\/\/ Timer fires between 60 and 65 seconds after each refresh"]},{"inlineContent":[{"text":"For data that refreshes every minute or more, a 5–10% tolerance has negligible UX impact but measurable battery benefit on mobile devices.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Combining-All-Three","text":"Combining All Three","type":"heading"},{"inlineContent":[{"text":"All three policies can coexist. Evaluation order within a single ","type":"text"},{"code":"refresh()","type":"codeVoice"},{"text":" call:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["1. TTL check  →  2. Debounce wait  →  3. Throttle check  →  4. Fetch"]},{"inlineContent":[{"text":"If TTL passes (data is fresh), the cached value is returned immediately and the rest of the pipeline is skipped — no debounce wait, no throttle delay, no fetch.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A complete example for a live sports scoreboard:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let scoreSource = dataSource {","    try await api.fetchLiveScores()","} onError: { _ in .keep }",".debounce(.milliseconds(100))   \/\/ Absorb rapid-fire triggers from events",".ttl(.seconds(5))               \/\/ Don't re-fetch within 5 seconds",".throttle(.seconds(2))          \/\/ Hard rate limit: max 1 fetch per 2 seconds",".autoRefresh(.seconds(15))      \/\/ Background refresh every 15 seconds",".build()"]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/Silo\/documentation\/Silo\/TimeControls","interfaceLanguage":"swift"},"references":{"doc://Silo/documentation/Silo/DataSource/restartAutoRefresh(immediate:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"restartAutoRefresh","kind":"identifier"},{"text":"(","kind":"text"},{"text":"immediate","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"title":"restartAutoRefresh(immediate:)","kind":"symbol","role":"symbol","url":"\/documentation\/silo\/datasource\/restartautorefresh(immediate:)","abstract":[{"text":"Restart auto-refresh timer.","type":"text"}],"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/restartAutoRefresh(immediate:)","type":"topic"},"doc://Silo/documentation/Silo/Caching":{"title":"Caching with TTL","kind":"article","role":"article","url":"\/documentation\/silo\/caching","abstract":[{"text":"Prevent redundant network calls by keeping fetched data valid for a configurable duration.","type":"text"}],"identifier":"doc:\/\/Silo\/documentation\/Silo\/Caching","type":"topic"},"doc://Silo/documentation/Silo":{"type":"topic","abstract":[{"text":"Reactive async data management for Swift 6 — fetch, cache, and stream data with zero dependencies.","type":"text"}],"role":"collection","title":"Silo","url":"\/documentation\/silo","kind":"symbol","identifier":"doc:\/\/Silo\/documentation\/Silo"},"doc://Silo/documentation/Silo/Prerequisites":{"title":"Prerequisites and Conditional Fetching","kind":"article","role":"article","url":"\/documentation\/silo\/prerequisites","abstract":[{"text":"Gate fetches on runtime conditions such as network availability or user authentication state.","type":"text"}],"identifier":"doc:\/\/Silo\/documentation\/Silo\/Prerequisites","type":"topic"},"doc://Silo/documentation/Silo/ErrorHandling":{"title":"Error Handling and Retry","kind":"article","role":"article","url":"\/documentation\/silo\/errorhandling","abstract":[{"text":"Decide what happens to cached data on failure, and configure automatic retry with backoff strategies.","type":"text"}],"identifier":"doc:\/\/Silo\/documentation\/Silo\/ErrorHandling","type":"topic"},"doc://Silo/documentation/Silo/DataSource/resumeAutoRefresh()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resumeAutoRefresh","kind":"identifier"},{"text":"()","kind":"text"}],"title":"resumeAutoRefresh()","kind":"symbol","role":"symbol","url":"\/documentation\/silo\/datasource\/resumeautorefresh()","abstract":[{"text":"Resume auto-refresh timer.","type":"text"}],"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/resumeAutoRefresh()","type":"topic"},"doc://Silo/documentation/Silo/DataSource/stopAutoRefresh()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stopAutoRefresh","kind":"identifier"},{"text":"()","kind":"text"}],"title":"stopAutoRefresh()","kind":"symbol","role":"symbol","url":"\/documentation\/silo\/datasource\/stopautorefresh()","abstract":[{"text":"Stop auto-refresh timer.","type":"text"}],"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/stopAutoRefresh()","type":"topic"},"doc://Silo/documentation/Silo/Dependencies":{"url":"\/documentation\/silo\/dependencies","identifier":"doc:\/\/Silo\/documentation\/Silo\/Dependencies","type":"topic","kind":"article","role":"article","abstract":[{"type":"text","text":"Automatically re-fetch data whenever upstream async stream values change."}],"title":"Dependencies and Reactive Fetching"}}}