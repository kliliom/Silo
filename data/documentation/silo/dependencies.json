{"variants":[{"paths":["\/documentation\/silo\/dependencies"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Silo\/documentation\/Silo"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Silo\/documentation\/Silo\/TimeControls","doc:\/\/Silo\/documentation\/Silo\/RefreshPolicy","doc:\/\/Silo\/documentation\/Silo\/DataSourceDependency","doc:\/\/Silo\/documentation\/Silo\/BeforeFetchError","doc:\/\/Silo\/tutorials\/Silo\/ReactiveDependencies"],"anchor":"Related-Documentation","title":"Related Documentation"},{"generated":true,"identifiers":["doc:\/\/Silo\/documentation\/Silo\/Caching","doc:\/\/Silo\/documentation\/Silo\/ErrorHandling","doc:\/\/Silo\/documentation\/Silo\/TimeControls","doc:\/\/Silo\/documentation\/Silo\/Prerequisites"],"anchor":"Guides","title":"Guides"}],"abstract":[{"text":"Automatically re-fetch data whenever upstream async stream values change.","type":"text"}],"metadata":{"modules":[{"name":"Silo"}],"title":"Dependencies and Reactive Fetching","role":"article","roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource","type":"reference","isActive":true},{"text":" can observe one or more upstream ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" values called ","type":"text"},{"inlineContent":[{"text":"dependencies","type":"text"}],"type":"emphasis"},{"text":". When a dependency emits a new value, the data source re-fetches — passing the latest dependency values directly into the fetch closure.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This is the idiomatic way to model data that derives from other changing state:","type":"text"}]},{"code":["\/\/ An upstream stream of the currently selected user ID","let selectedUserID: AsyncStream<Int>","","\/\/ Automatically re-fetches whenever the selected user changes","let postsSource = dataSource(selectedUserID.dependency(.eager)) { userID in","    try await api.fetchPosts(forUser: userID)","} onError: { _ in .keep }",".build()"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Without dependencies, you’d have to observe ","type":"text"},{"code":"selectedUserID","type":"codeVoice"},{"text":" yourself, cancel any in-flight request, and manually call ","type":"text"},{"code":"refresh()","type":"codeVoice"},{"text":". Silo handles all of that.","type":"text"}]},{"level":2,"type":"heading","anchor":"Declaring-a-Dependency","text":"Declaring a Dependency"},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":".dependency(_:)","type":"codeVoice"},{"text":" on any ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" to create a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSourceDependency"},{"text":", then pass it as the first argument to ","type":"text"},{"code":"dataSource()","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["let filterStream: AsyncStream<SortOrder>","","let productsSource = dataSource(filterStream.dependency(.lazy)) { sortOrder in","    try await api.fetchProducts(sortedBy: sortOrder)","} onError: { _ in .keep }",".build()"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The dependency value becomes a parameter to the fetch closure. Silo ensures the closure always receives the latest emitted value.","type":"text"}]},{"style":"important","content":[{"inlineContent":[{"type":"text","text":"The data source will not perform its first fetch until "},{"type":"emphasis","inlineContent":[{"text":"all","type":"text"}]},{"type":"text","text":" dependencies have emitted at least one value. If you have two dependencies and one emits before the other, the fetch is held until both have values."}],"type":"paragraph"}],"type":"aside","name":"Important"},{"level":2,"type":"heading","anchor":"Refresh-Policies","text":"Refresh Policies"},{"type":"paragraph","inlineContent":[{"text":"The policy controls ","type":"text"},{"inlineContent":[{"text":"when","type":"text"}],"type":"emphasis"},{"text":" a refresh is triggered in response to a dependency change:","type":"text"}]},{"text":"`.eager` — Refresh Immediately","level":3,"type":"heading","anchor":"eager-Refresh-Immediately"},{"syntax":"swift","type":"codeListing","code":["selectedUserID.dependency(.eager)"]},{"inlineContent":[{"type":"text","text":"Refresh happens immediately when the dependency emits, regardless of whether there are active subscribers. Use "},{"type":"codeVoice","code":".eager"},{"type":"text","text":" when you want data pre-warmed and ready before any view subscribes — for example, when you anticipate the user navigating to a screen."}],"type":"paragraph"},{"anchor":"lazy-Refresh-Only-When-Observed","text":"`.lazy` — Refresh Only When Observed","type":"heading","level":3},{"code":["selectedUserID.dependency(.lazy)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"If the dependency emits while there are no subscribers, the refresh is deferred. When the first subscriber arrives, the deferred refresh fires immediately, delivering fresh data right away."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"code":".lazy","type":"codeVoice"},{"type":"text","text":" for data that is only relevant when its corresponding UI is visible. This avoids network calls for screens the user hasn’t navigated to yet."}],"type":"paragraph"},{"anchor":"manual-Manual-Control","text":"`.manual` — Manual Control","type":"heading","level":3},{"code":["selectedUserID.dependency(.manual)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Dependency changes do not trigger automatic refreshes. The dependency value is still available in the fetch closure — you just control when "},{"code":"refresh()","type":"codeVoice"},{"type":"text","text":" is called yourself."}],"type":"paragraph"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":".manual"},{"text":" when you want the fetch closure to ","type":"text"},{"inlineContent":[{"text":"use","type":"text"}],"type":"emphasis"},{"text":" the upstream value but need external logic to decide the right time to refresh (for example, after a confirmation dialog).","type":"text"}],"type":"paragraph"},{"text":"Policy Comparison","level":3,"type":"heading","anchor":"Policy-Comparison"},{"rows":[[[{"inlineContent":[{"text":"Policy","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Refresh timing","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Best for","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".eager","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Immediately on change","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Pre-warming; always-fresh data","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".lazy","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When first subscriber arrives","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"On-demand screens; avoid unnecessary work","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".manual","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Never automatically","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Manual control; gated refresh","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"text":"Clearing on Dependency Change","level":2,"type":"heading","anchor":"Clearing-on-Dependency-Change"},{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"code":"clear: true","type":"codeVoice"},{"text":" to emit the empty value immediately when the dependency changes — before the new fetch completes:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["selectedUserID.dependency(.eager, clear: true)"]},{"type":"paragraph","inlineContent":[{"text":"Without ","type":"text"},{"code":"clear: true","type":"codeVoice"},{"text":", the previous user’s posts remain visible while the new user’s posts are being fetched. With ","type":"text"},{"code":"clear: true","type":"codeVoice"},{"text":", the list clears immediately on switch, showing a loading state until the new data arrives.","type":"text"}]},{"rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"text":"Without ","type":"text"},{"code":"clear: true","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"With ","type":"text"},{"code":"clear: true","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"On change","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Previous data shown during fetch","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Empty value shown during fetch","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Best for","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Smooth transitions (similar data)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Hard context switches (unrelated data)","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"text":"Multiple Dependencies","level":2,"type":"heading","anchor":"Multiple-Dependencies"},{"type":"paragraph","inlineContent":[{"text":"Pass multiple dependencies to observe several upstream streams simultaneously. The fetch closure receives all values as parameters:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let userID:   AsyncStream<Int>","let category: AsyncStream<Category>","let sortOrder: AsyncStream<SortOrder>","","let feedSource = dataSource(","    userID.dependency(.lazy),","    category.dependency(.lazy, clear: true),","    sortOrder.dependency(.lazy)",") { userID, category, sortOrder in","    try await api.fetchFeed(","        for: userID,","        in: category,","        sorted: sortOrder","    )","} onError: { _ in .keep }",".build()"]},{"type":"paragraph","inlineContent":[{"text":"The data source refreshes whenever ","type":"text"},{"inlineContent":[{"text":"any","type":"text"}],"type":"emphasis"},{"text":" dependency emits a new value, using the latest value of all others. The first fetch waits until every dependency has emitted at least once.","type":"text"}]},{"content":[{"inlineContent":[{"text":"Dependencies are implemented using Swift’s variadic generics (","type":"text"},{"code":"repeat each","type":"codeVoice"},{"text":"), so the type of each dependency value is fully preserved and compiler-checked.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"text":"Pre-fetch Hooks","level":2,"type":"heading","anchor":"Pre-fetch-Hooks"},{"type":"paragraph","inlineContent":[{"text":"Reactive dependencies let an upstream stream ","type":"text"},{"inlineContent":[{"text":"push","type":"text"}],"type":"emphasis"},{"text":" changes to a data source. Pre-fetch hooks are the complementary pattern: the data source ","type":"text"},{"inlineContent":[{"text":"pulls","type":"text"}],"type":"emphasis"},{"text":" from upstream immediately before each fetch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The primary use case is ensuring a related data source is fresh before your fetch runs:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let profileSource = dataSource {","    try await api.fetchProfile(token: authSource.value!)","} onError: { _ in .keep }",".beforeFetch(refresh: authSource)  \/\/ Refresh auth token first",".build()"]},{"type":"paragraph","inlineContent":[{"text":"Every time ","type":"text"},{"code":"profileSource.refresh()","type":"codeVoice"},{"text":" is called, ","type":"text"},{"code":"authSource.refresh()","type":"codeVoice"},{"text":" completes first. Because ","type":"text"},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/refresh(clear:)","type":"reference","isActive":true},{"text":" deduplicates in-flight requests, if ","type":"text"},{"code":"authSource","type":"codeVoice"},{"text":" is already refreshing the call simply joins that task — no redundant network request.","type":"text"}]},{"text":"General closure form","level":3,"type":"heading","anchor":"General-closure-form"},{"type":"paragraph","inlineContent":[{"text":"For preparation work that isn’t a ","type":"text"},{"code":"DataSource","type":"codeVoice"},{"text":" refresh, pass a closure directly:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let source = dataSource { ... }","    .beforeFetch {","        try await analyticsService.logFetchStarted()","    }","    .build()"]},{"type":"paragraph","inlineContent":[{"text":"Multiple ","type":"text"},{"code":".beforeFetch()","type":"codeVoice"},{"text":" calls run concurrently before the fetch. If any hook throws, the remaining hooks are cancelled:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["dataSource { ... }","    .beforeFetch(refresh: authSource)","    .beforeFetch(refresh: configSource)","    .build()"]},{"text":"Failable hooks","level":3,"type":"heading","anchor":"Failable-hooks"},{"type":"paragraph","inlineContent":[{"text":"If the pre-fetch work is best-effort — a failure shouldn’t block the main fetch — use ","type":"text"},{"code":".failableBeforeFetch()","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["dataSource { ... }","    .failableBeforeFetch { try await prefetchCache.warm() }","    .build()"]},{"type":"paragraph","inlineContent":[{"text":"Any error thrown by a failable hook is silently discarded and the fetch proceeds normally.","type":"text"}]},{"text":"Error handling","level":3,"type":"heading","anchor":"Error-handling"},{"type":"paragraph","inlineContent":[{"text":"When a ","type":"text"},{"code":".beforeFetch()","type":"codeVoice"},{"text":" hook throws, the error is wrapped in a ","type":"text"},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/BeforeFetchError","type":"reference","isActive":true},{"text":" before being passed to the ","type":"text"},{"code":"onError","type":"codeVoice"},{"text":" handler. This lets you distinguish a pre-fetch failure from a fetch failure:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["dataSource {","    try await api.fetchProfile(token: authSource.value!)","} onError: { error in","    if let beforeFetchError = error as? BeforeFetchError {","        \/\/ Auth token refresh failed — keep stale profile","        return .keep","    }","    \/\/ Fetch itself failed — clear stale data","    return .clear","}",".beforeFetch(refresh: authSource)",".build()"]},{"type":"paragraph","inlineContent":[{"text":"The hook runs after all gate checks (TTL, throttle, debounce, prerequisites) and only once per actual fetch task — concurrent ","type":"text"},{"code":"refresh()","type":"codeVoice"},{"text":" callers that join an in-flight task do not re-run it.","type":"text"}]},{"text":"Pre-fetch hooks vs reactive dependencies","level":3,"type":"heading","anchor":"Pre-fetch-hooks-vs-reactive-dependencies"},{"rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"text":"Reactive dependency","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Pre-fetch hook","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Direction","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Upstream pushes → source reacts","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Source pulls from upstream before fetching","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Trigger","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Upstream emits a new value","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Every ","type":"text"},{"code":"refresh()","type":"codeVoice"},{"text":" that proceeds past the gates","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Use when","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The upstream value is an ","type":"text"},{"inlineContent":[{"type":"text","text":"input"}],"type":"emphasis"},{"text":" to the fetch","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Another source must be fresh ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"text":" you fetch","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"text":"Combining Dependencies with Time Controls","level":2,"type":"heading","anchor":"Combining-Dependencies-with-Time-Controls"},{"type":"paragraph","inlineContent":[{"text":"Dependencies work naturally with debounce and throttle. A typical search pattern:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let searchQuery: AsyncStream<String>","","let resultsSource = dataSource(searchQuery.dependency(.lazy)) { query in","    guard !query.isEmpty else { return [] }","    return try await api.search(query: query)","} onError: { _ in .keep }",".debounce(.milliseconds(300))  \/\/ Wait for the user to pause typing",".build()"]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"searchQuery","type":"codeVoice"},{"text":" emits, Silo triggers a refresh, but the debounce delays execution until 300ms of silence — preventing a fetch on every keystroke.","type":"text"}]},{"text":"The Dependency Lifecycle","level":2,"type":"heading","anchor":"The-Dependency-Lifecycle"},{"syntax":null,"type":"codeListing","code":["Dependency emits value","    │","    ├─ .manual ────────────────────── No refresh triggered","    │","    ├─ .eager ─────────────────────── refresh() called immediately","    │                                 (regardless of subscriber count)","    │","    └─ .lazy ─── Has subscribers? ─── Yes ──► refresh() called immediately","                        │","                        No ──────────────────► Flag pending refresh","                                               │","                                         First subscriber arrives","                                               │","                                         refresh() called"]},{"text":"When Not to Use Dependencies","level":2,"type":"heading","anchor":"When-Not-to-Use-Dependencies"},{"type":"paragraph","inlineContent":[{"text":"Use dependencies when the upstream value is the ","type":"text"},{"inlineContent":[{"text":"input","type":"text"}],"type":"emphasis"},{"text":" to a fetch — e.g., the selected user ID determines which user’s data to load.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Don’t use dependencies as a mechanism to trigger a refresh when ","type":"text"},{"inlineContent":[{"text":"some other thing happens","type":"text"}],"type":"emphasis"},{"text":" — for that, just call ","type":"text"},{"code":"refresh()","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"restartAutoRefresh()","type":"codeVoice"},{"text":" directly.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ ✗ Don't: create a fake stream just to trigger refresh","let triggerStream = AsyncStream<Void> { ... }","let source = dataSource(triggerStream.dependency(.eager)) { _ in","    try await api.fetchData()","} onError: { _ in .keep }",".build()","","\/\/ ✓ Do: just call refresh() when the triggering condition occurs","let source = dataSource {","    try await api.fetchData()","} onError: { _ in .keep }",".build()","","\/\/ Later, when the condition occurs:","await source.refresh()"]}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Silo\/documentation\/Silo\/Dependencies"},"references":{"doc://Silo/documentation/Silo/DataSourceDependency":{"fragments":[{"kind":"keyword","text":"struct"},{"