ce"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Data Source Lifecycle","anchor":"Data-Source-Lifecycle"},{"syntax":null,"type":"codeListing","code":["Created           isEmpty: true   isRefreshing: false","   ↓","refresh() called  isEmpty: true   isRefreshing: true   (first fetch)","   ↓","Fetch succeeds    isEmpty: false  isRefreshing: false  → value emitted","   ↓","refresh() called  isEmpty: false  isRefreshing: true   (subsequent fetch)","   ↓","Fetch succeeds    isEmpty: false  isRefreshing: false  → value emitted (if changed)","   ↓","clear() \/ TTL     isEmpty: true   isRefreshing: false  → empty value emitted"]},{"level":2,"type":"heading","text":"Next Steps","anchor":"Next-Steps"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Add TTL caching and auto-expiry: "},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/Caching","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Configure retry and error handling: "},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/ErrorHandling","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Set up throttle, debounce, and periodic auto-refresh: "},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/TimeControls","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"React to upstream state changes with dependencies: "},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/Dependencies","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Gate fetches on conditions like network availability: "},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/Prerequisites","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Walk through building a complete app: "},{"identifier":"doc:\/\/Silo\/tutorials\/Silo\/BuildingA