{"sections":[],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Silo revolves around "},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource","type":"reference","isActive":true},{"type":"text","text":", a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" class that wraps an async fetch closure, maintains a cached value, and streams updates to all active subscribers. You create one with the "},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSourceBuilder","type":"reference","isActive":true},{"type":"text","text":" returned by the "},{"type":"codeVoice","code":"dataSource()"},{"type":"text","text":" function family, chain configuration methods, then call "},{"type":"codeVoice","code":".build()"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["@MainActor","let articlesSource = dataSource {","    try await api.fetchArticles()","} onError: { _ in .keep }",".ttl(.seconds(300))",".autoRefresh(.seconds(60))",".build()"],"type":"codeListing","syntax":"swift"},{"anchor":"Adding-Silo","type":"heading","level":2,"text":"Adding Silo"},{"inlineContent":[{"type":"text","text":"In your "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/kliliom\/silo\", from: \"2.0.0\")","],","targets: [","    .target(name: \"MyApp\", dependencies: [\"Silo\"])","]"],"type":"codeListing","syntax":"swift"},{"anchor":"Choosing-a-Builder-Overload","type":"heading","level":2,"text":"Choosing a Builder Overload"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"dataSource()"},{"type":"text","text":" function has overloads that eliminate boilerplate for common value types:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Overload to use"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Empty state"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"User?"},{"type":"text","text":", "},{"type":"codeVoice","code":"String?"},{"type":"text","text":", any "},{"type":"codeVoice","code":"Optional"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dataSource { ... } onError: { ... }"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nil"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[User]"},{"type":"text","text":", "},{"type":"codeVoice","code":"[String]"},{"type":"text","text":", any "},{"type":"codeVoice","code":"Array"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dataSource { ... } onError: { ... }"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[]"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[String: Any]"},{"type":"text","text":", any "},{"type":"codeVoice","code":"Dictionary"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dataSource { ... } onError: { ... }"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[:]"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any other type"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dataSource { ... } onError: { ... } emptyValue: { ... }"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your placeholder"}]}]]]},{"inlineContent":[{"type":"text","text":"For "},{"type":"codeVoice","code":"Optional"},{"type":"text","text":", "},{"type":"codeVoice","code":"Array"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":" values the empty state is inferred automatically. For any other type you must supply an "},{"type":"codeVoice","code":"emptyValue"},{"type":"text","text":" closure that returns a placeholder:"}],"type":"paragraph"},{"code":["\/\/ Optional — empty state is nil automatically","let profileSource = dataSource {","    try await api.fetchProfile() \/\/ User?","} onError: { _ in .keep }",".build()","","\/\/ Array — empty state is [] automatically","let usersSource = dataSource {","    try await api.fetchUsers() \/\/ [User]","} onError: { _ in .keep }",".build()","","\/\/ Custom type — must provide emptyValue","let statsSource = dataSource {","    try await api.fetchStats() \/\/ AppStats (non-optional struct)","} onError: { _ in .keep }","emptyValue: {","    AppStats.zero","}",".build()"],"type":"codeListing","syntax":"swift"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"dataSource()"},{"type":"text","text":" and all "},{"type":"codeVoice","code":"DataSource"},{"type":"text","text":" methods must be called on the "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":". Mark your containing type "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":", or call from within a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" context such as a "},{"type":"codeVoice","code":"Task { @MainActor in ... }"},{"type":"text","text":"."}]}]},{"anchor":"Understanding-the-Empty-Value","type":"heading","level":2,"text":"Understanding the Empty Value"},{"inlineContent":[{"type":"text","text":"The empty value is what a "},{"type":"codeVoice","code":"DataSource"},{"type":"text","text":" holds before its first successful fetch, and what it reverts to after "},{"type":"codeVoice","code":"clear()"},{"type":"text","text":" is called or a TTL expiry clears it. It serves as the “zero state” for the type — a safe default that makes the source always usable without optionality at the call site."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Choose an empty value that is safe to display. A "},{"type":"codeVoice","code":"User"},{"type":"text","text":" might have "},{"type":"codeVoice","code":"name: \"\""},{"type":"text","text":", a "},{"type":"codeVoice","code":"[Product]"},{"type":"text","text":" is already "},{"type":"codeVoice","code":"[]"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"Stats"},{"type":"text","text":" might have all counters at "},{"type":"codeVoice","code":"0"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Triggering-a-Fetch","type":"heading","level":2,"text":"Triggering a Fetch"},{"inlineContent":[{"text":"Call ","type":"text"},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/refresh(clear:)","type":"reference","isActive":true},{"text":" to load data. It returns the fetched value and throws on failure:","type":"text"}],"type":"paragraph"},{"code":["do {","    let articles = try await articlesSource.refresh()","    print(\"Loaded \\(articles.count) articles\")","} catch {","    print(\"Failed: \\(error)\")","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"refresh()"},{"text":" is idempotent with respect to in-flight requests: if one is already running when a second caller invokes ","type":"text"},{"type":"codeVoice","code":"refresh()"},{"text":", both callers await the same underlying task. No duplicate network calls are made.","type":"text"}],"type":"paragraph"},{"anchor":"Force-Refreshing-Past-the-Cache","type":"heading","level":3,"text":"Force-Refreshing Past the Cache"},{"inlineContent":[{"text":"Pass ","type":"text"},{"type":"codeVoice","code":"clear: true"},{"text":" to reset the cache and bypass any active TTL window:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Pull-to-refresh — ignore cache, always fetch fresh","let articles = try await articlesSource.refresh(clear: true)"],"type":"codeListing","syntax":"swift"},{"anchor":"Observing-Values","type":"heading","level":2,"text":"Observing Values"},{"inlineContent":[{"text":"Subscribe to ","type":"text"},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/values","type":"reference","isActive":true},{"text":" to receive the current cached value immediately, then live updates whenever a ","type":"text"},{"type":"codeVoice","code":"refresh()"},{"text":" completes:","type":"text"}],"type":"paragraph"},{"code":["for await articles in articlesSource.values {","    tableView.reloadData(with: articles)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first element delivered to a new subscriber is always the current cached value — this might be the empty value if no fetch has happened yet, or the last successfully fetched value otherwise. This makes stream subscriptions self-bootstrapping: no separate “initial load” call is required."}]},{"style":"tip","type":"aside","name":"Tip","content":[{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".task { }"},{"type":"text","text":" in SwiftUI views to subscribe and automatically cancel when the view disappears."}],"type":"paragraph"}]},{"anchor":"Custom-Buffering","type":"heading","text":"Custom Buffering","level":3},{"inlineContent":[{"type":"text","text":"The default stream buffers all values without limit. For fast-changing data, limit the buffer to avoid queuing stale values:"}],"type":"paragraph"},{"code":["\/\/ Only keep the most recent update for a fast-changing source","for await price in stockSource.values(bufferingPolicy: .bufferingNewest(1)) {","    updatePriceLabel(price)","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Tracking-Loading-and-Empty-State","type":"heading","text":"Tracking Loading and Empty State","level":2},{"type":"paragraph","inlineContent":[{"text":"Subscribe to ","type":"text"},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/state","isActive":true,"type":"reference"},{"type":"text","text":" to drive loading indicators and empty-state views:"}]},{"code":["for await state in articlesSource.state {","    loadingView.isHidden = !state.isRefreshing","    emptyView.isHidden = !state.isEmpty","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSourceState"},{"text":" has two boolean properties:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Property","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"true","type":"codeVoice"},{"text":" when…","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":" when…"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"isRefreshing"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A fetch is in progress"}]}],[{"type":"paragraph","inlineContent":[{"text":"No fetch is running","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"isEmpty"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The current value is the empty value"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Data has been successfully fetched","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Possible state combinations:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isRefreshing"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isEmpty"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Meaning"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"false"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"true"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Initial state — nothing fetched yet"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"true"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"false"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Refreshing while showing existing data"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"}]}],[{"inlineContent":[{"text":"First fetch in progress (or refreshing after clear)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"false"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"false"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Data loaded and idle"}]}]]]},{"anchor":"Observing-Value-and-State-Together","text":"Observing Value and State Together","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/valueWithState","type":"reference","isActive":true},{"type":"text","text":" to get a "},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSourceValueWithState","isActive":true,"type":"reference"},{"type":"text","text":" snapshot on every change — value or state. This is the most convenient stream for driving a SwiftUI view:"}]},{"syntax":"swift","type":"codeListing","code":["for await snapshot in articlesSource.valueWithState {","    loadingSpinner.isVisible = snapshot.state.isRefreshing","    updateList(snapshot.value)","}"]},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"text":"Subscribing to ","type":"text"},{"type":"codeVoice","code":"valueWithState"},{"type":"text","text":" counts toward the active subscriber count for auto-refresh purposes, just like "},{"type":"codeVoice","code":"values"},{"text":" does.","type":"text"}],"type":"paragraph"}]},{"text":"Clearing Cached Data","type":"heading","level":2,"anchor":"Clearing-Cached-Data"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Silo\/documentation\