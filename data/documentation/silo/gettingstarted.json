 empty state immediately:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func signOut() async {","    profileSource.clear()","    articlesSource.clear()","}"]},{"inlineContent":[{"type":"text","text":"Clearing:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets the cached value to the result of "},{"type":"codeVoice","code":"emptyValue()"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Emits the empty value to all "},{"type":"codeVoice","code":"values"},{"type":"text","text":" subscribers"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isEmpty"},{"type":"text","text":" to "},{"type":"codeVoice","code":"true"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancels active TTL, throttle, and debounce timers"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Does "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" cancel an in-flight fetch task"}]}]}],"type":"unorderedList"},{"text":"Cancelling In-Flight Fetches","level":2,"type":"heading","anchor":"Cancelling-In-Flight-Fetches"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/cancelRefresh(clear:)","type":"reference"},{"text":" cancels any running fetch task:","type":"text"}]},{"syntax":"swift","code":["\/\/ Cancel without clearing cache","articlesSource.cancelRefresh()","","\/\/ Cancel and wipe the cache","articlesSource.cancelRefresh(clear: true)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any "},{"type":"codeVoice","code":"refresh()"},{"type":"text","text":" callers waiting on the cancelled task receive a "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":"."}]},{"text":"Data Source Lifecycle","level":2,"ty