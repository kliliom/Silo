{"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Silo revolves around "},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource","isActive":true,"type":"reference"},{"text":", a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" class that wraps an async fetch closure, maintains a cached value, and streams updates to all active subscribers. You create one with the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSourceBuilder"},{"type":"text","text":" returned by the "},{"type":"codeVoice","code":"dataSource()"},{"type":"text","text":" function family, chain configuration methods, then call "},{"code":".build()","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","code":["@MainActor","let articlesSource = dataSource {","    try await api.fetchArticles()","} onError: { _ in .keep }",".ttl(.seconds(300))",".autoRefresh(.seconds(60))",".build()"],"type":"codeListing"},{"anchor":"Adding-Silo","text":"Adding Silo","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"In your ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/kliliom\/silo\", from: \"2.0.0\")","],","targets: [","    .target(name: \"MyApp\", dependencies: [\"Silo\"])","]"],"type":"codeListing"},{"level":2,"text":"Choosing a Builder Overload","type":"heading","anchor":"Choosing-a-Builder-Overload"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"dataSource()"},{"type":"text","text":" function has overloads that eliminate boilerplate for common value types:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value type"}]}],[{"type":"paragraph","inlineContent":[{"text":"Overload to use","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Empty state"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"User?"},{"type":"text","text":", "},{"type":"codeVoice","code":"String?"},{"text":", any ","type":"text"},{"type":"codeVoice","code":"Optional"}]}],[{"type":"paragraph","inlineContent":[{"code":"dataSource { ... } onError: { ... }","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"nil","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"[User]"},{"text":", ","type":"text"},{"code":"[String]","type":"codeVoice"},{"text":", any ","type":"text"},{"type":"codeVoice","code":"Array"}]}],[{"type":"paragraph","inlineContent":[{"code":"dataSource { ... } onError: { ... }","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"[]","type":"codeVoice"}]}]],[[{"inlineContent":[{"code":"[String: Any]","type":"codeVoice"},{"type":"text","text":", any "},{"code":"Dictionary","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"dataSource { ... } onError: { ... }"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"[:]"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Any other type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"dataSource { ... } onError: { ... } emptyValue: { ... }","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Your placeholder","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For "},{"type":"codeVoice","code":"Optional"},{"type":"text","text":", "},{"type":"codeVoice","code":"Array"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":" values the empty state is inferred automatically. For any other type you must supply an "},{"type":"codeVoice","code":"emptyValue"},{"type":"text","text":" closure that returns a placeholder:"}]},{"code":["\/\/ Optional — empty state is nil automatically","let profileSource = dataSource {","    try await api.fetchProfile() \/\/ User?","} onError: { _ in .keep }",".build()","","\/\/ Array — empty state is [] automatically","let usersSource = dataSource {","    try await api.fetchUsers() \/\/ [User]","} onError: { _ in .keep }",".build()","","\/\/ Custom type — must provide emptyValue","let statsSource = dataSource {","    try await api.fetchStats() \/\/ AppStats (non-optional struct)","} onError: { _ in .keep }","emptyValue: {","    AppStats.zero","}",".build()"],"type":"codeListing","syntax":"swift"},{"style":"important","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"dataSource()"},{"type":"text","text":" and all "},{"type":"codeVoice","code":"DataSource"},{"type":"text","text":" methods must be called on the "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":". Mark your containing type "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":", or call from within a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" context such as a "},{"type":"codeVoice","code":"Task { @MainActor in ... }"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","name":"Important"},{"text":"Understanding the Empty Value","level":2,"type":"heading","anchor":"Understanding-the-Empty-Value"},{"inlineContent":[{"type":"text","text":"The empty value is what a "},{"type":"codeVoice","code":"DataSource"},{"type":"text","text":" holds before its first successful fetch, and what it reverts to after "},{"type":"codeVoice","code":"clear()"},{"type":"text","text":" is called or a TTL expiry clears it. It serves as the “zero state” for the type — a safe default that makes the source always usable without optionality at the call site."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Choose an empty value that is safe to display. A "},{"code":"User","type":"codeVoice"},{"type":"text","text":" might have "},{"code":"name: \"\"","type":"codeVoice"},{"type":"text","text":", a "},{"code":"[Product]","type":"codeVoice"},{"text":" is already ","type":"text"},{"type":"codeVoice","code":"[]"},{"text":", and a ","type":"text"},{"code":"Stats","type":"codeVoice"},{"text":" might have all counters at ","type":"text"},{"code":"0","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Triggering a Fetch","level":2,"anchor":"Triggering-a-Fetch","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/refresh(clear:)","type":"reference","isActive":true},{"text":" to load data. It returns the fetched value and throws on failure:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["do {","    let articles = try await articlesSource.refresh()","    print(\"Loaded \\(articles.count) articles\")","} catch {","    print(\"Failed: \\(error)\")","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"refresh()"},{"type":"text","text":" is idempotent with respect to in-flight requests: if one is already running when a second caller invokes "},{"type":"codeVoice","code":"refresh()"},{"type":"text","text":", both callers await the same underlying task. No duplicate network calls are made."}]},{"text":"Force-Refreshing Past the Cache","type":"heading","level":3,"anchor":"Force-Refreshing-Past-the-Cache"},{"inlineContent":[{"text":"Pass ","type":"text"},{"code":"clear: true","type":"codeVoice"},{"text":" to reset the cache and bypass any active TTL window:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Pull-to-refresh — ignore cache, always fetch fresh","let articles = try await articlesSource.refresh(clear: true)"]},{"text":"Observing Values","type":"heading","level":2,"anchor":"Observing-Values"},{"inlineContent":[{"type":"text","text":"Subscribe to "},{"type":"reference","identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/values","isActive":true},{"type":"text","text":" to receive the current cached value immediately, then live updates whenever a "},{"type":"codeVoice","code":"refresh()"},{"type":"text","text":" completes:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["for await articles in articlesSource.values {","    tableView.reloadData(with: articles)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first element delivered to a new subscriber is always the current cached value — this might be the empty value if no fetch has happened yet, or the last successfully fetched value otherwise. This makes stream subscriptions self-bootstrapping: no separate “initial load” call is required."}]},{"style":"tip","type":"aside","name":"Tip","content":[{"inlineContent":[{"text":"Use ","type":"text"},{"code":".task { }","type":"codeVoice"},{"text":" in SwiftUI views to subscribe and automatically cancel when the view disappears.","type":"text"}],"type":"paragraph"}]},{"text":"Custom Buffering","type":"heading","anchor":"Custom-Buffering","level":3},{"type":"paragraph","inlineContent":[{"text":"The default stream buffers all values without limit. For fast-changing data, limit the buffer to avoid queuing stale values:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Only keep the most recent update for a fast-changing source","for await price in stockSource.values(bufferingPolicy: .bufferingNewest(1)) {","    updatePriceLabel(price)","}"]},{"text":"Tracking Loading and Empty State","type":"heading","anchor":"Tracking-Loading-and-Empty-State","level":2},{"type":"paragraph","inlineContent":[{"text":"Subscribe to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSource\/state"},{"text":" to drive loading indicators and empty-state views:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["for await state in articlesSource.state {","    loadingView.isHidden = !state.isRefreshing","    emptyView.isHidden = !state.isEmpty","}"]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Silo\/documentation\/Silo\/DataSourceState"},{"text":" has two boolean properties:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"},{"text":" when…","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"false","type":"codeVoice"},{"text":" when…","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"isRefreshing","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A fetch is in progress"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No fetch is running"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"isEmpty","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The current value is the empty value"}]}],[{"type":"paragraph","inlineContent":[{"text":"Data has been successfully fetched","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Possible state combinations:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"code":"isRefreshing","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isEmpty"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Meaning"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Initial state — nothing fetched yet"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"}]}],[{"type":"paragraph","inlineContent":[{"code":"false","type":"codeVoice"}]}],[{"type":"paragraph","inlineCon